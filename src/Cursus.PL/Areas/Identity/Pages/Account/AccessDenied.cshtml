@page
@model Cursus.PL.Areas.Identity.Pages.Account.AccessDeniedModel

@{
    ViewData["Title"] = "Access Denied";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="login-split">

  <div class="login-panel-left d-none d-lg-flex">
    <div class="login-brand-content">
      <div class="anim-fade-in">
        <h1 class="login-brand-title">Cursus</h1>
      </div>
      <p class="login-brand-sub anim-fade-up">
        Your AI-Powered Academic Advisor<span class="cursor"></span>
      </p>
      <div class="login-pills anim-fade-up-2">
        <span class="login-pill">Graduation Planner</span>
        <span class="login-pill">Drop/Fail Analyzer</span>
        <span class="login-pill">AI Chatbot</span>
      </div>
    </div>
    <div class="login-bottom-tag anim-fade-in">
      <p>DEPI Graduation Project · 2026</p>
    </div>
  </div>

  <div class="login-panel-right">

    <div class="login-mobile-logo d-lg-none anim-fade-up">
      <h1>Cursus</h1>
      <p>Academic Advisor</p>
    </div>

    <div class="login-form-wrap">
      <div class="ad-card anim-fade-in">
        <div class="ad-icon-wrap anim-fade-up">
          <span class="material-symbols-outlined ad-icon">lock</span>
        </div>

        <div class="login-heading text-center anim-fade-up-1">
          <h2>Access Denied</h2>
          <p>You do not have permission to access this page.</p>
        </div>

        <div class="fp-success-note anim-fade-up-2">
          <span class="material-symbols-outlined fp-note-icon">info</span>
          <span>If you believe this is a mistake, please contact your administrator.</span>
        </div>

        <div class="ad-actions anim-fade-up-3">
          <a asp-controller="Home" asp-action="Index" class="login-btn-primary w-100 d-block text-center text-decoration-none">
            Go to Home
          </a>
          <a asp-page="./Login" class="ad-link">
            Sign in with a different account
          </a>
        </div>

      </div>
    </div>
  </div>
</div>

<style>
  .ad-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
  }

  .ad-icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(220, 53, 69, 0.08);
    border: 1.5px solid rgba(220, 53, 69, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .ad-icon {
    font-size: 2rem;
    color: #dc3545;
  }

  .ad-card .fp-success-note {
    text-align: left;
    margin-bottom: 1.75rem;
    width: 100%;
  }

  .ad-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  .ad-link {
    font-size: 0.8rem;
    color: var(--c-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .ad-link:hover {
    color: var(--c-primary);
  }
</style>