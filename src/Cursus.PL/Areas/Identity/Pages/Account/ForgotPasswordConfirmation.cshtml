@page
@model Cursus.PL.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Email Sent";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="login-split">

  <div class="login-panel-left d-none d-lg-flex">
    <div class="login-brand-content">
      <div class="anim-fade-in"><h1 class="login-brand-title">Cursus</h1></div>
      <p class="login-brand-sub anim-fade-up">Your AI-Powered Academic Advisor<span class="cursor"></span></p>
    </div>
    <div class="login-bottom-tag anim-fade-in">
      <p>DEPI Graduation Project · 2026</p>
    </div>
  </div>

  <div class="login-panel-right">
    <div class="login-form-wrap">
      <div class="fp-success">
        <div class="fp-success-icon anim-fade-in">
          <span class="material-symbols-outlined">mark_email_read</span>
        </div>

        <div class="login-heading text-center anim-fade-up-1">
          <h2>Check your email</h2>
          <p>If an account exists with that email, we've sent a password reset link.</p>
        </div>

        <div class="fp-success-note anim-fade-up-2">
          <span class="material-symbols-outlined fp-note-icon">info</span>
          <span>The link expires in <strong>30 minutes</strong>. Check your spam folder if you don't see it.</span>
        </div>

        <div class="anim-fade-up-3">
          <a asp-page="./Login" class="login-btn-primary w-100 d-block text-center text-decoration-none">
            Back to Sign In
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
