@using System.Security.Claims
@using Microsoft.AspNetCore.Identity

@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = isAuthenticated && User.IsInRole(Roles.Admin);
    var isSuperAdmin = isAuthenticated && User.IsInRole(Roles.SuperAdmin);
    var isStudent = isAuthenticated && User.IsInRole(Roles.Student);

    var accountEmail = isAuthenticated
        ? (User.FindFirstValue(ClaimTypes.Email) ?? User.Identity?.Name ?? string.Empty)
        : string.Empty;
    var displayName = string.IsNullOrEmpty(accountEmail)
        ? "User"
        : (accountEmail.Contains('@') ? accountEmail.Split('@')[0] : accountEmail);
    var initials = string.Concat(displayName.Where(char.IsUpper));
    if (initials.Length < 2) initials = displayName.Length >= 2 ? displayName[..2].ToUpper() : displayName.ToUpper();

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction    = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<nav class="navbar-cursus fixed-top">
  <div class="container-xl px-3 px-md-4 d-flex align-items-center justify-content-between w-100" style="height:64px;">

    <div class="d-flex align-items-center gap-3">
      @if (isSuperAdmin)
      {
        <a asp-controller="Admin" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none me-1">
          <span class="fw-900 brand-name" style="font-size:17px;letter-spacing:-.5px;color:#1a1f2e;">Cursus</span>
        </a>
        <div class="d-none d-md-flex align-items-center gap-1">
          <a asp-controller="Admin" asp-action="Index"
             class="nav-pill @(currentController=="Admin"&&currentAction=="Index"?"active":"")">Dashboard</a>
          <a asp-controller="Admin" asp-action="UniversityIndex"
             class="nav-pill @(currentController=="Admin"&&(currentAction=="UniversityIndex"||currentAction=="UniversityCreate")?"active":"")">Universities</a>
          <a asp-controller="Admin" asp-action="UniversityAdmins"
             class="nav-pill @(currentController=="Admin"&&currentAction!=null&&currentAction.StartsWith("UniversityAdmin")?"active":"")">Admins</a>
        </div>
      }
      else if (isAdmin)
      {
        <a asp-controller="Admin" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none me-1">
          <span class="fw-900 brand-name" style="font-size:17px;letter-spacing:-.5px;color:#1a1f2e;">Cursus</span>
        </a>
        <div class="d-none d-md-flex align-items-center gap-1">
          <a asp-controller="Admin" asp-action="Index"
             class="nav-pill @(currentController=="Admin"&&currentAction=="Index"?"active":"")">Dashboard</a>
          <a asp-controller="Admin" asp-action="Courses"
             class="nav-pill @(currentController=="Admin"&&(currentAction=="Courses"||currentAction=="CourseCreate"||currentAction=="CourseEdit")?"active":"")">Courses</a>
          <a asp-controller="Admin" asp-action="Students"
             class="nav-pill @(currentController=="Admin"&&currentAction=="Students"?"active":"")">Students</a>
        </div>
      }
      else if (isStudent)
      {
        <a asp-controller="Student" asp-action="Dashboard" class="d-flex align-items-center gap-2 text-decoration-none me-1">
          <span class="fw-900 brand-name" style="font-size:17px;letter-spacing:-.5px;color:#1a1f2e;">Cursus</span>
        </a>
        <div class="d-none d-md-flex align-items-center gap-1">
          <a asp-controller="Student" asp-action="Dashboard"
             class="nav-pill @(currentController=="Student"&&currentAction=="Dashboard"?"active":"")">Dashboard</a>
          <a asp-controller="Student" asp-action="CourseMap"
             class="nav-pill @(currentController=="Student"&&currentAction=="CourseMap"?"active":"")">Course Map</a>
          <a asp-controller="Student" asp-action="Planner"
             class="nav-pill @(currentController=="Student"&&currentAction=="Planner"?"active":"")">Planner</a>
          <a asp-controller="Student" asp-action="Progress"
             class="nav-pill @(currentController=="Student"&&currentAction=="Progress"?"active":"")">Progress</a>
          <a asp-controller="Student" asp-action="AiAdvisor"
             class="nav-pill @(currentController=="Student"&&currentAction=="AiAdvisor"?"active":"")">AI Advisor</a>
        </div>
      }
      else
      {
        <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none me-1">
          <span class="fw-900 brand-name" style="font-size:17px;letter-spacing:-.5px;color:#1a1f2e;">Cursus</span>
        </a>
        <div class="d-none d-md-flex align-items-center gap-1">
          <a asp-controller="Home" asp-action="Index"
             class="nav-pill @(currentController=="Home"&&currentAction=="Index"?"active":"")">Home</a>
        </div>
      }
    </div>

    <div class="d-flex align-items-center gap-1">

      <button id="dark-toggle" class="btn btn-link p-2 rounded-circle" style="color:var(--c-muted);" aria-label="Toggle dark mode">
        <span class="material-symbols-outlined" id="dark-icon" style="font-size:20px;font-variation-settings:'FILL' 0,'wght' 300">dark_mode</span>
      </button>

      @if (isAuthenticated)
      {
        <div class="position-relative">
          <button id="notif-btn" class="btn btn-link p-2 rounded-circle position-relative" style="color:var(--c-muted);">
            <span class="material-symbols-outlined" style="font-size:20px;font-variation-settings:'FILL' 0,'wght' 300">notifications</span>
            <span class="notif-dot position-absolute rounded-circle bg-danger" style="width:8px;height:8px;top:6px;right:6px;border:2px solid white;"></span>
          </button>
          <div id="notif-panel" class="notif-panel d-none position-absolute end-0 mt-2 surface shadow-lg overflow-hidden" style="z-index:1060;border-radius:14px;">
            <div class="px-4 py-3 d-flex align-items-center justify-content-between" style="border-bottom:1px solid var(--c-border);">
              <span class="fw-700" style="font-size:13px;">Notifications</span>
              <span class="fw-600" style="font-size:12px;cursor:pointer;color:var(--c-primary);">Mark all read</span>
            </div>
            <div class="px-4 py-3 text-center">
              <p class="mb-0" style="font-size:12px;color:var(--c-muted);">No new notifications</p>
            </div>
          </div>
        </div>

        <div class="custom-select-wrap position-relative ms-1 d-none d-md-block">
          <button id="user-btn" class="user-avatar-btn d-flex align-items-center gap-2" onclick="toggleDropdown('user')">
            <div class="d-flex align-items-center justify-content-center rounded-circle fw-700 flex-shrink-0"
                 style="width:36px;height:36px;background:@(isAdmin||isSuperAdmin?"rgba(239,68,68,0.1)":"var(--c-soft)");border:2px solid @(isAdmin||isSuperAdmin?"rgba(239,68,68,0.2)":"rgba(79,70,229,.2)");color:@(isAdmin||isSuperAdmin?"#dc2626":"var(--c-primary)");font-size:13px;">@initials</div>
            <div class="d-none d-md-block text-start">
              <p class="mb-0 fw-700 lh-1" style="font-size:13.5px;color:var(--c-text);">@displayName</p>
              <p class="mb-0 lh-1" style="font-size:11px;color:var(--c-muted);">@(isSuperAdmin?"Super Admin":isAdmin?"Administrator":"Student")</p>
            </div>
            <span class="material-symbols-outlined" id="user-menu-chevron"
                  style="font-size:16px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300;transition:transform 0.22s ease;">expand_more</span>
          </button>
          <div id="user-dropdown" class="user-menu custom-dropdown position-absolute end-0 mt-2" style="min-width:210px;z-index:1060;">
            <div class="px-4 py-3" style="border-bottom:1px solid var(--c-border);">
              <p class="fw-700 mb-0" style="font-size:13px;color:var(--c-text);">@displayName</p>
              @if (!string.IsNullOrEmpty(accountEmail))
              {
                <p class="mb-0" style="font-size:11px;color:var(--c-muted);">@accountEmail</p>
              }
            </div>
            @if (isAdmin)
            {
              <a asp-controller="Admin" asp-action="Profile" class="custom-dropdown-item text-decoration-none" style="color:var(--c-text);">
                <span class="material-symbols-outlined" style="font-size:17px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">manage_accounts</span>
                <span class="custom-dropdown-label">My Profile</span>
              </a>
            }
            else if (isStudent)
            {
              <a asp-controller="Student" asp-action="Profile" class="custom-dropdown-item text-decoration-none" style="color:var(--c-text);">
                <span class="material-symbols-outlined" style="font-size:17px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">manage_accounts</span>
                <span class="custom-dropdown-label">My Profile</span>
              </a>
            }
            <div style="border-top:1px solid var(--c-border);">
              <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index","Home",new{area=""})" method="post">
                <button type="submit" class="custom-dropdown-item text-decoration-none w-100 border-0 bg-transparent text-start">
                  <span class="material-symbols-outlined" style="font-size:17px;color:#dc2626;font-variation-settings:'FILL' 0,'wght' 300">logout</span>
                  <span class="custom-dropdown-label" style="color:#dc2626;">Sign Out</span>
                </button>
              </form>
            </div>
          </div>
        </div>

        <button class="navbar-hamburger d-flex d-md-none align-items-center justify-content-center ms-1"
                id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
          <span class="material-symbols-outlined" style="font-size:22px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">menu</span>
        </button>
      }
      else
      {
        <a asp-area="Identity" asp-page="/Account/Login" class="nav-pill fw-600">Sign In</a>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary fw-700 px-3 py-2" style="border-radius:10px;font-size:13px;">Register</a>
      }
    </div>
  </div>
</nav>

@if (isAuthenticated)
{
  <div id="mobile-drawer-backdrop" class="mobile-drawer-backdrop" aria-hidden="true"></div>

  <aside id="mobile-drawer" class="mobile-drawer d-md-none" role="dialog" aria-modal="true" aria-label="Navigation menu">

    <div class="mobile-drawer-header">
      <div class="d-flex align-items-center gap-2">
        <div class="d-flex align-items-center justify-content-center rounded-circle fw-700"
             style="width:38px;height:38px;background:@(isAdmin||isSuperAdmin?"rgba(239,68,68,0.1)":"var(--c-soft)");border:2px solid @(isAdmin||isSuperAdmin?"rgba(239,68,68,0.2)":"rgba(79,70,229,.2)");color:@(isAdmin||isSuperAdmin?"#dc2626":"var(--c-primary)");font-size:13px;flex-shrink:0;">@initials</div>
        <div>
          <p class="mb-0 fw-700 lh-1" style="font-size:14px;color:var(--c-text);">@displayName</p>
          <p class="mb-0 lh-1" style="font-size:11px;color:var(--c-muted);">@(isSuperAdmin?"Super Admin":isAdmin?"Administrator":"Student")</p>
        </div>
      </div>
      <button id="mobile-drawer-close" class="btn btn-link p-1" aria-label="Close menu" style="color:var(--c-muted);">
        <span class="material-symbols-outlined" style="font-size:22px;font-variation-settings:'FILL' 0,'wght' 300">close</span>
      </button>
    </div>

    <nav class="mobile-drawer-nav">
      @if (isSuperAdmin)
      {
        <a asp-controller="Admin" asp-action="Index"
           class="mobile-nav-item @(currentController=="Admin"&&currentAction=="Index"?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">dashboard</span>
          <span>Dashboard</span>
        </a>
        <a asp-controller="Admin" asp-action="UniversityIndex"
           class="mobile-nav-item @(currentController=="Admin"&&(currentAction=="UniversityIndex"||currentAction=="UniversityCreate")?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">account_balance</span>
          <span>Universities</span>
        </a>
        <a asp-controller="Admin" asp-action="UniversityAdmins"
           class="mobile-nav-item @(currentController=="Admin"&&currentAction!=null&&currentAction.StartsWith("UniversityAdmin")?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">admin_panel_settings</span>
          <span>Admins</span>
        </a>
      }
      else if (isAdmin)
      {
        <a asp-controller="Admin" asp-action="Index"
           class="mobile-nav-item @(currentController=="Admin"&&currentAction=="Index"?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">dashboard</span>
          <span>Dashboard</span>
        </a>
        <a asp-controller="Admin" asp-action="Courses"
           class="mobile-nav-item @(currentController=="Admin"&&(currentAction=="Courses"||currentAction=="CourseCreate"||currentAction=="CourseEdit")?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">menu_book</span>
          <span>Courses</span>
        </a>
        <a asp-controller="Admin" asp-action="Students"
           class="mobile-nav-item @(currentController=="Admin"&&currentAction=="Students"?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">group</span>
          <span>Students</span>
        </a>
      }
      else if (isStudent)
      {
        <a asp-controller="Student" asp-action="Dashboard"
           class="mobile-nav-item @(currentController=="Student"&&currentAction=="Dashboard"?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">dashboard</span>
          <span>Dashboard</span>
        </a>
        <a asp-controller="Student" asp-action="CourseMap"
           class="mobile-nav-item @(currentController=="Student"&&currentAction=="CourseMap"?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">account_tree</span>
          <span>Course Map</span>
        </a>
        <a asp-controller="Student" asp-action="Planner"
           class="mobile-nav-item @(currentController=="Student"&&currentAction=="Planner"?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">calendar_today</span>
          <span>Planner</span>
        </a>
        <a asp-controller="Student" asp-action="Progress"
           class="mobile-nav-item @(currentController=="Student"&&currentAction=="Progress"?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">bar_chart</span>
          <span>Progress</span>
        </a>
        <a asp-controller="Student" asp-action="AiAdvisor"
           class="mobile-nav-item @(currentController=="Student"&&currentAction=="AiAdvisor"?"active":"")">
          <span class="material-symbols-outlined mobile-nav-icon">smart_toy</span>
          <span>AI Advisor</span>
        </a>
      }
    </nav>

    <div class="mobile-drawer-footer">
      <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index","Home",new{area=""})" method="post">
        <button type="submit" class="mobile-nav-item w-100 border-0 bg-transparent text-start" style="color:#dc2626;">
          <span class="material-symbols-outlined mobile-nav-icon" style="color:#dc2626;font-variation-settings:'FILL' 0,'wght' 300">logout</span>
          <span>Sign Out</span>
        </button>
      </form>
    </div>
  </aside>
}

