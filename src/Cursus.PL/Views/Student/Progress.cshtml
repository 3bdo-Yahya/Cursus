    </div>

    <div class="row g-3" data-scroll-group>
      @{
        // Animation delay index so cards stagger in.
        double delayBase = 0.5;
      }

      @foreach (var cat in audit.Categories)
      {
        var color     = ProgressViewModel.GetCategoryColorSuffix(cat.CourseType);
        var icon      = ProgressViewModel.GetCategoryIcon(cat.CourseType);
        var iconColor = ProgressViewModel.GetCategoryIconColor(cat.CourseType);
        var iconBg    = ProgressViewModel.GetCategoryIconBg(cat.CourseType);
        var delay     = delayBase.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "s";
        delayBase    += 0.1;

        // Split courses: first 4 visible, rest hidden behind "Show more".
        var visibleCourses = cat.Courses.Take(4).ToList();
        var hiddenCourses  = cat.Courses.Skip(4).ToList();
        var hiddenCount    = hiddenCourses.Count;

        <div class="col-12 col-md-6">
          <div class="category-card h-100">

            <!-- Card header -->
            <div class="category-card-header">
              <div class="d-flex align-items-center gap-3 flex-1 min-w-0">
                <div class="category-icon-box" style="background:@iconBg;">
                  <span class="material-symbols-outlined"
                        style="font-size:19px;color:@iconColor;font-variation-settings:'FILL' 1,'wght' 500">@icon</span>
                </div>
                <div class="min-w-0">
                  <div class="category-title">@cat.Label</div>
                  <div class="category-sub">@cat.Description</div>
                </div>
              </div>
              <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                @if (cat.RequiredCredits > 0)
                {
                  <span class="cr-badge cr-badge-@color">@cat.EarnedCredits / @cat.RequiredCredits cr</span>
                  <div style="font-size:10.5px;color:var(--c-muted);">@cat.Percentage%</div>
                }
                else
                {
                  <span class="cr-badge cr-badge-@color">@cat.EarnedCredits cr earned</span>
                }
              </div>
            </div>

            <!-- Progress bar -->
            <div class="px-4 pb-2">
              <div class="cat-bar-track">
                <div class="cat-bar-fill cat-bar-@color" style="--bar-w:@(cat.Percentage)%;--bar-delay:@delay;"></div>
              </div>
            </div>

            <!-- Course list -->
            <div class="cat-course-list">
              @foreach (var course in visibleCourses)
              {
                var statusCss   = ProgressViewModel.GetStatusCssClass(course.Status);
                var statusIcon  = ProgressViewModel.GetStatusIconName(course.Status);
                var statusColor = ProgressViewModel.GetStatusIconColor(course.Status);
                var statusVar   = ProgressViewModel.GetStatusIconVariation(course.Status);

                <div class="cat-course-item">
                  <div class="course-status-icon @statusCss">
                    <span class="material-symbols-outlined"
                          style="font-size:14px;color:@statusColor;font-variation-settings:@statusVar">@statusIcon</span>
                  </div>
                  <span class="course-code-badge">@course.Code</span>
                  <span class="course-name-text @(course.Status == CourseAuditStatus.Locked ? "course-name-locked" : "")">
                    @course.Name @(course.Status == CourseAuditStatus.Locked ? "(Locked)" : "")
                  </span>
                  <span class="course-credits-pill">@course.CreditHours cr</span>

                  @switch (course.Status)
                  {
                    case CourseAuditStatus.Completed:
                      <span class="course-grade-pill @ProgressViewModel.GetGradePillClass(course.Grade)">@course.Grade</span>
                      break;
                    case CourseAuditStatus.InProgress:
                      <span style="font-size:10.5px;font-weight:700;color:var(--c-primary);">In Progress</span>
                      break;
                    case CourseAuditStatus.Failed:
                      <span style="font-size:10.5px;font-weight:700;color:#ef4444;">Failed</span>
                      break;
                    default:
                      <span style="font-size:10.5px;color:var(--c-muted);">@course.Status</span>
                      break;
                  }
                </div>
              }

              @foreach (var course in hiddenCourses)
              {
                var statusCss   = ProgressViewModel.GetStatusCssClass(course.Status);
