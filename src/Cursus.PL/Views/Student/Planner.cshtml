@model Cursus.PL.Models.PlannerViewModel
@using Cursus.PL

@{
    ViewData["Title"] = "Semester Planner";
    var progressPct = Model.TotalCreditsRequired > 0
        ? Math.Min((double)Model.CompletedCredits / Model.TotalCreditsRequired * 100, 100)
        : 0;
}

<script>
    window.STUDENT_DATA = {
        studentId: '@Model.StudentId',
        completedCourses: @Html.Raw(ViewJson.Serialize(Model.CompletedCourses)),
        inProgressCourses: @Html.Raw(ViewJson.Serialize(Model.InProgressCourses)),
        completedCredits: @Model.CompletedCredits,
        totalCredits: @Model.TotalCreditsRequired,
        creditLimit: @Model.CreditLimit,
        overloadLimit: @Model.OverloadLimit,
        isOverloadEligible: @(Model.IsOverloadEligible ? "true" : "false"),
        studentCgpa: @Model.CurrentCgpa,
        term: @Html.Raw(ViewJson.Serialize(Model.PrimaryTermCapacity)),
        plannedCourses: @Html.Raw(ViewJson.Serialize(Model.PlannedCourses)),
        catalog: @Html.Raw(ViewJson.Serialize(Model.Catalog)),
        currentlyEnrolled: @Html.Raw(ViewJson.Serialize(Model.CurrentlyEnrolledCourses))
    };
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/student/semester-planner.css" asp-append-version="true"/>
}

<div class="d-flex flex-column gap-4">
  @Html.AntiForgeryToken()

  <!-- Page Header -->
  <section class="anim-fade-up">
    <div class="d-flex flex-column flex-sm-row align-items-sm-start justify-content-between gap-3">
      <div>
        <h1 class="fw-900 mb-1" style="font-size:1.55rem;letter-spacing:-.4px;color:var(--c-text);">Semester Planner</h1>
        <p class="mb-0" style="font-size:13px;color:var(--c-muted);">
            @Model.StudentName · @Model.Department · Year @Model.Year · @Model.Semester
        </p>
      </div>
      <!-- Semester selector -->
      <div class="semester-tabs flex-shrink-0">
        <button class="sem-tab active">@($"{Model.PrimaryTermCapacity.Semester} {Model.PrimaryTermCapacity.AcademicYear}")</button>
      </div>
    </div>
  </section>

  <div class="planner-layout">

    <!-- ── Left ─────────────────────────────── -->
    <div class="d-flex flex-column gap-3">
      <div class="plan-card anim-fade-up-1" id="plan-card-main">
        <div class="plan-card-header">
          <div>
            <div class="plan-card-title">@($"{Model.PrimaryTermCapacity.Semester} {Model.PrimaryTermCapacity.AcademicYear}")</div>
            <div class="plan-card-subtitle">Planned semester · @Model.CreditLimit credit limit (@Model.AcademicStanding)</div>
          </div>
          <span class="credit-chip credit-chip-empty" id="credit-chip">0 / @Model.CreditLimit cr</span>
        </div>

        <!-- Planned courses list -->
        <div id="planned-courses-list">
          <div id="planned-empty-state" class="planned-empty-state">
            <span class="material-symbols-outlined" style="font-size:22px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">playlist_add</span>
            <p class="mb-0" style="font-size:13px;color:var(--c-muted);">No courses planned yet — add courses below to build your semester.</p>
          </div>
        </div>

        <!-- Add course row -->
        <div class="add-dropdown-wrap">
          <div class="add-course-row" onclick="toggleAddDropdown()">
            <span class="material-symbols-outlined" style="font-size:17px !important;font-variation-settings:'FILL' 0,'wght' 400">add_circle</span>
            <span class="add-course-label">Add a course</span>
          </div>
          <div class="add-dropdown" id="add-dropdown">
            <div class="add-search-wrap position-relative">
              <span class="material-symbols-outlined add-search-icon" style="font-variation-settings:'FILL' 0,'wght' 300">search</span>
              <input type="text" class="add-search-input" id="add-search-input"
                     placeholder="Search available courses…"
                     oninput="filterAddList(this.value)"/>
            </div>
            <div class="add-dropdown-list" id="add-dropdown-list">
            </div>
          </div>
        </div>
      </div>

      <!-- Current semester enrollment -->
      <div class="anim-fade-up-2" data-scroll="fade-up">
        <p class="section-heading mb-2" style="font-size:13px;color:var(--c-muted);font-weight:700;letter-spacing:.04em;text-transform:uppercase;">Current Semester · In Progress</p>
        <div class="d-flex flex-column gap-2">
          @if (Model.CurrentlyEnrolledCourses.Any())
          {
              <div class="plan-card" style="opacity:.75;">
                <div class="plan-card-header">
                  <div>
                    <div class="plan-card-title" style="font-size:13.5px;">@Model.Semester</div>
                    <div class="plan-card-subtitle">Currently enrolled courses</div>
                  </div>
                  <span class="credit-chip credit-chip-ok">@Model.CurrentlyEnrolledCourses.Sum(c => c.Credits) cr</span>
                </div>
                <div style="padding:10px 0 6px;">
                  @foreach (var sc in Model.CurrentlyEnrolledCourses)
                  {
                      <div class="planned-row" style="cursor:default;">
                        <span class="planned-code">@sc.Id</span>
                        <span class="planned-name">@sc.Name</span>
                        <span class="planned-type-badge @sc.TypeClass">@sc.Type</span>
                        <span class="planned-credits">@sc.Credits cr</span>
                        <span style="font-size:10.5px;font-weight:700;color:var(--c-primary);margin-left:auto;">In Progress</span>
                      </div>
                  }
                </div>
              </div>
          }
          else
          {
              <div style="font-size: 13px; color: var(--c-muted); padding: 10px;">
                  No courses currently in progress.
              </div>
          }
        </div>
      </div>
    </div>

    <!-- ── Right: Sticky ─────────────────────────── -->
    <div class="plan-sidebar anim-fade-up-3">

      <!-- Plan Summary -->
      <div class="summary-card">
        <div class="summary-card-header">
          <span class="material-symbols-outlined">event_note</span>
          <p class="fw-800 mb-0" style="font-size:13.5px;color:var(--c-text);">Plan Summary</p>
        </div>
        <div class="summary-stat-row">
          <span class="summary-stat-label">Planned credits</span>
          <span class="summary-stat-value" id="stat-planned-cr">0 cr</span>
        </div>
        <div class="summary-stat-row">
          <span class="summary-stat-label">Credit limit</span>
          <span class="summary-stat-value" id="stat-cr-limit">@Model.CreditLimit (@Model.AcademicStanding)</span>
        </div>
        <div class="summary-stat-row">
          <span class="summary-stat-label">Credits after semester</span>
          <span class="summary-stat-value" id="stat-total-after">@Model.CompletedCredits / @Model.TotalCreditsRequired</span>
        </div>
        <div class="summary-stat-row">
          <span class="summary-stat-label">Courses planned</span>
          <span class="summary-stat-value" id="stat-course-count">0</span>
        </div>
        <div class="summary-stat-row">
          <span class="summary-stat-label">Prerequisite conflicts</span>
          <span class="summary-stat-value ok" id="stat-conflicts">None ✓</span>
        </div>
        <div class="mini-bar-track">
          <div class="mini-bar-fill" id="plan-bar" style="--bar-w: @progressPct.ToString("0.0")%;"></div>
        </div>
        <div style="padding:0 20px 12px;display:flex;justify-content:space-between;">
          <span style="font-size:11px;color:var(--c-muted);">@Model.CompletedCredits completed</span>
          <span style="font-size:11px;color:var(--c-muted);font-weight:700;" id="progress-pct-label">@progressPct.ToString("0.0")%</span>
          <span style="font-size:11px;color:var(--c-muted);">@Model.TotalCreditsRequired total</span>
        </div>
      </div>

      <!-- Alerts -->
      <div id="sidebar-alerts">

        <div class="sidebar-alert alert-ok">
          <div class="sidebar-alert-icon" style="background:var(--alert-ok-icon);">
            <span class="material-symbols-outlined" style="color:var(--alert-ok-title);">verified</span>
          </div>
          <div>
            <p class="fw-800 mb-0" style="font-size:12.5px;color:var(--alert-ok-title);">No prerequisite conflicts</p>
            <p class="mb-0" style="font-size:11.5px;color:var(--alert-ok-text);line-height:1.5;">All planned courses have their prerequisites satisfied.</p>
          </div>
        </div>

        @if (Model.IsOverloadEligible)
        {
            <div class="sidebar-alert alert-info">
              <div class="sidebar-alert-icon" style="background:var(--alert-info-icon);">
                <span class="material-symbols-outlined" style="color:var(--alert-info-title);">bolt</span>
              </div>
              <div>
                <p class="fw-800 mb-0" style="font-size:12.5px;color:var(--alert-info-title);">Overload available</p>
                <p class="mb-0" style="font-size:11.5px;color:var(--alert-info-text);line-height:1.5;">Your GPA (@Model.CurrentCgpa.ToString("0.00")) qualifies you for overload — up to @Model.OverloadLimit credits.</p>
              </div>
            </div>
        }

        <div class="sidebar-alert alert-warn" id="alert-grad" style="display:none;">
          <div class="sidebar-alert-icon" style="background:var(--alert-warn-icon);">
            <span class="material-symbols-outlined" style="color:var(--alert-warn-title);">warning</span>
          </div>
          <div>
            <p class="fw-800 mb-0" style="font-size:12.5px;color:var(--alert-warn-title);">Over credit limit!</p>
            <p class="mb-0 warn-text" style="font-size:11.5px;color:var(--alert-warn-text);line-height:1.5;">This plan exceeds your @Model.CreditLimit-credit limit.</p>
          </div>
        </div>

      </div>

      <!-- Save Button -->
      <button class="save-plan-btn mt-2" onclick="savePlan()">
        <span class="material-symbols-outlined">save</span>
        Save Semester Plan
      </button>

      <!-- Projected graduation -->
      <div class="surface p-3 mt-3 d-flex align-items-center gap-3" style="border-radius:14px;">
        <span class="material-symbols-outlined" style="font-size:20px;color:var(--c-primary);font-variation-settings:'FILL' 1,'wght' 500">school</span>
        <div>
          <p class="fw-800 mb-0" style="font-size:13px;color:var(--c-text);">Projected Graduation</p>
          <p class="mb-0" style="font-size:12px;color:var(--c-muted);" id="proj-grad-text">Spring 2027 → <strong style="color:var(--c-primary)">Fall 2027</strong> with this plan</p>
        </div>
      </div>
    </div>
  </div>
</div>
@section Scripts {
    <script src="~/js/pages/student/semester-planner.js" asp-append-version="true"></script>
}

