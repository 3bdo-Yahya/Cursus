@model StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/student/student-dashboard.css" asp-append-version="true"/>
}

<div class="d-flex flex-column gap-4">

  <!-- Welcome Bar -->
  <section class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 pt-2 anim-fade-up">
    <div class="d-flex align-items-center gap-3">
      <div class="position-relative flex-shrink-0">
        <div class="d-flex align-items-center justify-content-center rounded-3 text-white fw-900 user-select-none"
             style="width:62px;height:62px;font-size:20px;
                    background:linear-gradient(135deg,#4F46E5,#7c3aed);
                    box-shadow:0 8px 24px rgba(79,70,229,.28);">@Model.Initials</div>
        <div class="status-dot"></div>
      </div>
      <div>
        <h2 id="greeting-text" class="fw-800 mb-1" data-username="@Model.StudentName" style="font-size:1.4rem;letter-spacing:-.3px;color:var(--c-text);"></h2>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <span style="font-size:13px;color:var(--c-muted);">@Model.Department · Year @Model.Year · @Model.Semester</span>
          <span class="d-inline-flex align-items-center gap-1 rounded-pill px-2 py-1 fw-700 badge-standing standing-@Model.StandingCssClass" style="font-size:11px;">
            <span class="rounded-circle standing-dot-@Model.StandingCssClass" style="width:5px;height:5px;display:inline-block;flex-shrink:0;"></span>
            @Model.AcademicStanding
          </span>
        </div>
      </div>
    </div>
    <a asp-controller="Student" asp-action="Planner"
       class="btn btn-primary d-flex align-items-center gap-2 fw-700 px-4 py-2"
       style="border-radius:12px;box-shadow:0 4px 14px rgba(79,70,229,.3);font-size:13.5px;">
      <span class="material-symbols-outlined" style="font-size:17px;font-variation-settings:'FILL' 1,'wght' 400">calendar_today</span>
      Schedule Sync
    </a>
  </section>

  @if (Model.ShowStandingAlert)
  {
    <section class="anim-fade-up-1">
      <div class="standing-alert status-@Model.StandingCssClass">
        <span class="material-symbols-outlined" style="font-size:18px;font-variation-settings:'FILL' 1,'wght' 400">warning</span>
        <span>@Model.StandingAlertMessage</span>
      </div>
    </section>
  }

  <partial name="_StudentAlerts" />
  <!-- Metric Cards -->
  <section class="row g-3 anim-fade-up-1" data-scroll-group>

    <!-- CGPA -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="surface metric-card h-100 p-4">
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div>
            <p class="fw-700 mb-2 text-uppercase" style="font-size:10px;letter-spacing:.08em;color:var(--c-muted);">CGPA</p>
            <p class="fw-900 lh-1 mb-1" style="font-size:2.2rem;letter-spacing:-1px;color:var(--c-text);">@Model.Cgpa.ToString("F2")</p>
            <p class="fw-600 mb-0" style="font-size:11px;color:@(Model.CgpaChange >= 0 ? "#10b981" : "#dc3545");">
              @(Model.CgpaChange >= 0 ? "↑ +" : "↓ -")@Math.Abs(Model.CgpaChange).ToString("F2") from last semester
            </p>
          </div>
          <div class="position-relative flex-shrink-0" style="width:52px;height:52px;">
            <svg viewBox="0 0 48 48" width="52" height="52" style="transform:rotate(-90deg)">
              <circle cx="24" cy="24" r="19" fill="none" stroke="var(--c-border)" stroke-width="4"/>
              <circle id="gpa-ring" cx="24" cy="24" r="19" fill="none" stroke="var(--c-primary)" stroke-width="4"
              stroke-linecap="round" stroke-dasharray="119.4" stroke-dashoffset="119.4"
              data-cgpa="@Model.Cgpa.ToString("F2")" data-max-gpa="@Model.MaxGpa.ToString("F2")"/>
            </svg>
            <span class="position-absolute top-50 start-50 translate-middle fw-800" style="font-size:10px;color:var(--c-primary);">@Model.CgpaPercentage%</span>
          </div>
        </div>
        <div class="pt-2" style="border-top:1px solid var(--c-border);">
          <span style="font-size:11px;color:var(--c-muted);">Out of @Model.MaxGpa max</span>
        </div>
      </div>
    </div>

    <!-- Credits -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="surface metric-card h-100 p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <p class="fw-700 mb-0 text-uppercase" style="font-size:10px;letter-spacing:.08em;color:var(--c-muted);">Credits</p>
          <div class="d-flex align-items-center justify-content-center rounded-2 icon-box-blue" style="width:32px;height:32px;">
            <span class="material-symbols-outlined" style="font-size:16px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">auto_stories</span>
          </div>
        </div>
        <p class="fw-900 lh-1 mb-0" style="font-size:2.2rem;letter-spacing:-1px;color:var(--c-text);">
          @Model.CreditsEarned <span class="fw-500" style="font-size:1rem;color:var(--c-muted);">/ @Model.CreditsRequired</span>
        </p>
        <div class="rounded-pill overflow-hidden mt-3 mb-2" style="height:7px;background:var(--c-border);">
          <div class="credits-bar" style="--target-w:@(Model.CreditPercentage)%;"></div>
        </div>
        <p class="mb-0" style="font-size:11px;color:var(--c-muted);">@Model.CreditPercentage% of degree completed</p>
      </div>
    </div>

    <!-- Courses Left -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="surface metric-card h-100 p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <p class="fw-700 mb-0 text-uppercase" style="font-size:10px;letter-spacing:.08em;color:var(--c-muted);">Courses Left</p>
          <div class="d-flex align-items-center justify-content-center rounded-2 icon-box-purple" style="width:32px;height:32px;">
            <span class="material-symbols-outlined" style="font-size:16px;color:#7c3aed;font-variation-settings:'FILL' 0,'wght' 400">list_alt</span>
          </div>
        </div>
        <p class="fw-900 lh-1 mb-3" style="font-size:2.2rem;letter-spacing:-1px;color:var(--c-text);">@Model.CoursesRemaining</p>
        <div class="d-flex flex-wrap gap-1">
          <span class="rounded-pill px-2 py-1 fw-700 badge-core" style="font-size:11px;">@Model.CoreCoursesRemaining Core</span>
          <span class="rounded-pill px-2 py-1 fw-700 badge-elective" style="font-size:11px;">@Model.ElectiveCoursesRemaining Electives</span>
          <span class="rounded-pill px-2 py-1 fw-700 badge-unireq" style="font-size:11px;">@Model.UniversityRequiredCoursesRemaining Uni Req</span>
        </div>
      </div>
    </div>

    <!-- Graduation -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="surface metric-card h-100 p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <p class="fw-700 mb-0 text-uppercase" style="font-size:10px;letter-spacing:.08em;color:var(--c-muted);">Graduation</p>
          <div class="d-flex align-items-center justify-content-center rounded-2 icon-box-amber" style="width:32px;height:32px;">
            <span class="material-symbols-outlined text-warning" style="font-size:16px;font-variation-settings:'FILL' 1,'wght' 400">school</span>
          </div>
        </div>
        <p class="fw-900 lh-1 mb-1" style="font-size:1.65rem;letter-spacing:-.5px;color:var(--c-text);">@Model.GraduationSemester</p>
        <p class="mb-3" style="font-size:11px;color:var(--c-muted);">On track · @(Model.TotalSemesters / 2.0) years total</p>
        <div class="d-flex align-items-center gap-1">
          @for (var i = 0; i < Model.TotalSemesters; i++)
          {
            <div class="sem-pip" style="background:@(i < Model.SemestersCompleted ? "#22c55e" : "var(--c-border)");"></div>
          }
          <span class="ms-1 flex-shrink-0" style="font-size:11px;color:var(--c-muted);">@Model.SemestersCompleted / @Model.TotalSemesters</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Tiles -->
  <section class="row g-3" data-scroll-group>
    <div class="col-6 col-lg-3">
      <a asp-controller="Student" asp-action="CourseMap" class="surface feature-tile">
        <div class="tile-icon tile-blue">
          <span class="material-symbols-outlined" style="font-size:22px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 300">map</span>
        </div>
        <span class="fw-700" style="font-size:13px;">Course Map</span>
      </a>
    </div>
    <div class="col-6 col-lg-3">
      <a asp-controller="Student" asp-action="Planner" class="surface feature-tile">
        <div class="tile-icon tile-green">
          <span class="material-symbols-outlined text-success" style="font-size:22px;font-variation-settings:'FILL' 0,'wght' 300">event_note</span>
        </div>
        <span class="fw-700" style="font-size:13px;">Semester Planner</span>
      </a>
    </div>
    <div class="col-6 col-lg-3">
      <a asp-controller="Student" asp-action="Progress" class="surface feature-tile">
        <div class="tile-icon tile-red">
          <span class="material-symbols-outlined text-danger" style="font-size:22px;font-variation-settings:'FILL' 0,'wght' 300">pending_actions</span>
        </div>
        <span class="fw-700" style="font-size:13px;">Progress Tracker</span>
      </a>
    </div>
    <div class="col-6 col-lg-3">
      <a asp-controller="Student" asp-action="AIAdvisor" class="surface feature-tile">
        <div class="tile-icon tile-purple">
          <span class="material-symbols-outlined" style="font-size:22px;color:#7c3aed;font-variation-settings:'FILL' 0,'wght' 300">psychology</span>
        </div>
        <span class="fw-700" style="font-size:13px;">AI Advisor</span>
      </a>
    </div>
  </section>

  <!-- Schedule -->
  <section class="row g-4">
    <div class="col-12 col-lg-7" data-scroll="fade-right">
      <div class="surface d-flex flex-column h-100 overflow-hidden">
        <div class="d-flex align-items-center justify-content-between px-4 py-3" style="border-bottom:1px solid var(--c-border);">
          <h3 class="fw-800 mb-0" style="font-size:14px;color:var(--c-text);">@Model.Semester Courses</h3>
          <a asp-controller="Student" asp-action="CourseMap" class="fw-700 text-decoration-none" style="font-size:12px;color:var(--c-primary);">Full map →</a>
        </div>
        <div class="flex-fill p-3 d-flex flex-column gap-1">
          @foreach (var course in Model.CurrentCourses)
          {
            <div class="course-row">
              <div class="course-bar" style="background:@(course.IsElective ? "#ddd6fe" : "#c7d2fe");"></div>
              <div class="flex-fill min-w-0">
                <p class="fw-700 mb-0 text-truncate" style="font-size:13px;color:var(--c-text);">@course.Code: @course.Name</p>
                <p class="mb-0" style="font-size:11px;color:var(--c-muted);">@course.Schedule</p>
              </div>
              @if (course.IsElective)
              {
                <span class="rounded-2 fw-600 flex-shrink-0 badge-elec-cr" style="font-size:11px;padding:3px 8px;">Elective</span>
              }
              else
              {
                <span class="rounded-2 fw-600 flex-shrink-0" style="font-size:11px;padding:3px 8px;background:var(--c-border);color:var(--c-muted);">@course.CreditHours cr</span>
              }
            </div>
          }
        </div>
        <div class="d-flex align-items-center justify-content-between px-4 py-2 bg-token" style="border-top:1px solid var(--c-border);">
          <span style="font-size:11px;color:var(--c-muted);">Total: @Model.TotalCurrentCredits credits this semester</span>
          <span class="fw-700" style="font-size:11px;color:#059669;">✓ Within limit</span>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-5" data-scroll="fade-left">
      <div class="d-flex align-items-center justify-content-between mb-3 px-1">
        <h3 class="fw-800 mb-0" style="font-size:15px;letter-spacing:-.2px;color:var(--c-text);">Alerts &amp; Updates</h3>
        <span style="font-size:12px;color:var(--c-muted);">2 unread</span>
      </div>
      <div class="d-flex flex-column gap-2">
        <div class="alert-item alert-warn">
          <div class="alert-icon alert-icon-warn">
            <span class="material-symbols-outlined" style="font-size:17px;color:var(--alert-warn-title);font-variation-settings:'FILL' 1,'wght' 400">warning</span>
          </div>
          <div class="flex-fill min-w-0">
            <p class="fw-700 mb-1 alert-title-warn" style="font-size:13px;">Grade improvement available</p>
            <p class="mb-0 alert-text-warn" style="font-size:12px;line-height:1.55;"><strong>CS102: Data Structures</strong> (D) — retaking could boost CGPA to 3.32</p>
          </div>
        </div>
        <div class="alert-item alert-ok">
          <div class="alert-icon alert-icon-ok">
            <span class="material-symbols-outlined" style="font-size:17px;color:var(--alert-ok-title);font-variation-settings:'FILL' 1,'wght' 400">task_alt</span>
          </div>
          <div class="flex-fill min-w-0">
            <p class="fw-700 mb-1 alert-title-ok" style="font-size:13px;">Credit overload eligible</p>
            <p class="mb-0 alert-text-ok" style="font-size:12px;line-height:1.55;">Your GPA qualifies you for <strong>up to 21 credits</strong> next semester</p>
          </div>
        </div>
        <div class="alert-item alert-info">
          <div class="alert-icon alert-icon-info">
            <span class="material-symbols-outlined" style="font-size:17px;color:var(--alert-info-title);font-variation-settings:'FILL' 1,'wght' 400">info</span>
          </div>
          <div class="flex-fill min-w-0">
            <p class="fw-700 mb-1 alert-title-info" style="font-size:13px;">Registration opens soon</p>
            <p class="mb-0 alert-text-info" style="font-size:12px;line-height:1.55;">Fall 2026 registration begins <strong>May 15</strong> — plan ahead using the Semester Planner.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>

@section Scripts {
    <script src="~/js/pages/student/student-dashboard.js" asp-append-version="true"></script>
}
