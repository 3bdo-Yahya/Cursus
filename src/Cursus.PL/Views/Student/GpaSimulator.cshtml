        improvableCourses: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(Model.ImprovableCourses)
                ),

        gradeScale: @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(Model.GradeScale)
                )
    };
</script>

