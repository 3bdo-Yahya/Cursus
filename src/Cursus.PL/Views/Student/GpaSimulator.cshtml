      <div class="improvement-card">
        <div class="improvement-header">
          <span class="material-symbols-outlined" style="font-size:19px;color:#b45309;font-variation-settings:'FILL' 1,'wght' 500">restart_alt</span>
          <div>
            <p class="fw-800 mb-0" style="font-size:13.5px;color:var(--c-text);">Grade Improvement Eligible</p>
            <p class="mb-0" style="font-size:11.5px;color:var(--c-muted);margin-top:1px;">Courses you previously failed (grade F) — simulate retaking them</p>
          </div>
        </div>
        <div id="improvement-body"></div>
      </div>
