      <div class="grade-table-card">
        <div class="grade-table-head d-flex align-items-start justify-content-between">
          <div>
            <p class="fw-800 mb-0" style="font-size:14px;color:var(--c-text);">Predict Your Grades</p>
            <p class="mb-0" style="font-size:11.5px;color:var(--c-muted);margin-top:2px;">Select expected grades for your current semester — results update live</p>
          </div>
