    <!-- ── Right Column ───────────────── -->
    <div class="col-12 col-lg-5">
      <div class="d-flex flex-column gap-4" style="position:sticky;top:84px;">

        <!-- Live Prediction Hero -->
        <div class="results-hero anim-fade-up-2">
          <p class="predicted-gpa-label">Live Prediction</p>

          <div class="row g-0">
            <div class="col-6">
              <div class="predicted-gpa-label">Predicted SGPA</div>
              <div class="predicted-gpa-value" id="predicted-sgpa">—</div>
              <div class="predicted-gpa-sublabel">This semester</div>
            </div>
            <div class="col-6" style="border-left:1px solid rgba(255,255,255,.15);padding-left:20px;">
              <div class="predicted-gpa-label">Predicted CGPA</div>
              <div class="predicted-gpa-value" id="predicted-cgpa">—</div>
              <div class="predicted-gpa-sublabel">
                <span id="cgpa-change-label"></span>
              </div>
            </div>
          </div>

          <div id="standing-pill" class="standing-pill">
            Select grades to see prediction
          </div>

          <div id="honor-badge-wrap" class="honor-badge-wrap">
            <span id="honor-badge-inner"></span>
          </div>
        </div>

        <div class="target-card anim-fade-up-3">
          <div class="d-flex align-items-center gap-2 mb-3">
            <span class="material-symbols-outlined" style="font-size:18px;color:var(--c-primary);font-variation-settings:'FILL' 1,'wght' 500">flag</span>
            <p class="fw-800 mb-0" style="font-size:13.5px;color:var(--c-text);">Set a Target CGPA</p>
          </div>

          <div class="d-flex align-items-center gap-3 mb-1">
            <p class="mb-0 fw-600 flex-1" style="font-size:12px;color:var(--c-muted);">Target</p>
            <span id="target-value-display" class="fw-900" style="font-size:1.2rem;color:var(--c-primary);letter-spacing:-.5px;">3.50</span>
          </div>

          <input type="range" id="target-slider" class="gpa-slider mb-2" min="1.0" max="4.0" step="0.05" value="3.50"/>

          <div class="d-flex justify-content-between mb-3">
            <span style="font-size:10.5px;color:var(--c-muted);">1.0</span>
            <span style="font-size:10.5px;color:var(--c-muted);">2.0 min grad</span>
            <span style="font-size:10.5px;color:var(--c-muted);">4.0</span>
          </div>

          <div id="target-result" class="target-result"></div>
        </div>

        <div class="stats-card anim-fade-up-4">
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="material-symbols-outlined" style="font-size:18px;color:var(--c-primary);font-variation-settings:'FILL' 1,'wght' 500">insights</span>
            <p class="fw-800 mb-0" style="font-size:13.5px;color:var(--c-text);">Semester Summary</p>
          </div>
          <div style="margin-top:12px;">
            <div class="stats-row">
              <span class="stats-label">Semester Credits</span>
              <span class="stats-value" id="stat-semester-credits">—</span>
            </div>
            <div class="stats-row">
              <span class="stats-label">Total Completed Credits</span>
                            <span class="stats-value">@Model.CompletedCredits</span>
                        </div>
            <div class="stats-row">
              <span class="stats-label">Existing Quality Points</span>
                            <span class="stats-value">@Model.CompletedQp.ToString("0.00")</span>
            </div>
            <div class="stats-row">
              <span class="stats-label">CGPA Change</span>
              <span class="stats-value" id="stat-cgpa-impact">—</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
@section Scripts {
    <script>
        window.GPA_SIMULATOR_DATA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            currentCgpa = Model.CurrentCgpa,
            lastSemesterGpa = Model.LastSemesterGpa,
            minGpaForGraduation = Model.MinGpaForGraduation,
            completedCredits = Model.CompletedCredits,
            completedQualityPoints = Model.CompletedQualityPoints,
            currentCourses = Model.CurrentCourses,
            improvableCourses = Model.ImprovableCourses
        }));
    </script>
    <script src="~/js/pages/student/gpa-simulator.js" asp-append-version="true"></script>
}
