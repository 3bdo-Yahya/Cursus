@using Cursus.Domain.DTOs
@model IEnumerable<CourseDto>

@{
    ViewData["Title"] = "Course Management";
    var list = Model.ToList();
    var includeInactive = (bool?)ViewData["IncludeInactive"] ?? false;
    var searchTerm = ViewData["SearchTerm"] as string;
    var selectedDepartmentId = ViewData["SelectedDepartmentId"]?.ToString();
    var total = list.Count;
    var active = list.Count(c => c.IsActive);
    var inactive = list.Count(c => !c.IsActive);

    string AvailClass(SemesterAvailability s) => s switch
    {
        SemesterAvailability.Fall => "avail-fall",
        SemesterAvailability.Spring => "avail-spring",
        SemesterAvailability.FallSpring => "avail-both",
        SemesterAvailability.All => "avail-all",
        _ => "avail-all"
    };

    (string Icon, string Label) AvailMeta(SemesterAvailability s) => s switch
    {
        SemesterAvailability.Fall => ("ac_unit", "Fall"),
        SemesterAvailability.Spring => ("wb_sunny", "Spring"),
        SemesterAvailability.FallSpring => ("event_repeat", "Fall & Spring"),
        SemesterAvailability.All => ("calendar_month", "All semesters"),
        _ => ("calendar_month", s.ToString())
    };

    (string Css, string Label) TypeMeta(CourseType t) => t switch
    {
        CourseType.Core => ("type-core", "Core"),
        CourseType.DeptElective => ("type-elective", "Dept elective"),
        CourseType.FreeElective => ("type-elective", "Free elective"),
        CourseType.UniversityReq => ("type-elective", "Univ req"),
        _ => ("type-core", t.ToString())
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/courses.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row align-items-sm-start justify-content-between gap-3 mb-4 anim-fade-up">
    <div>
        <h1 class="fw-900 mb-1" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Courses</h1>
        <p class="mb-0" style="font-size:13px;color:var(--c-muted);">
            Search and manage catalog courses by department.
        </p>
    </div>
    <a asp-action="CourseCreate"
       class="btn btn-primary d-flex align-items-center gap-2 fw-700 flex-shrink-0 text-decoration-none"
       style="border-radius:12px;font-size:13px;padding:9px 18px;box-shadow:0 4px 14px rgba(79,70,229,.28);">
        <span class="material-symbols-outlined"
              style="font-size:17px;font-variation-settings:'FILL' 1,'wght' 400">add</span>
        Add course
    </a>
</div>

<partial name="_AdminAlerts" />

<div class="d-flex flex-wrap gap-2 mb-4 anim-fade-up-1">
    <div class="stat-pill d-flex align-items-center gap-2">
        <span class="stat-pill-dot" style="background:#4F46E5;"></span>
        <span class="fw-700" style="font-size:13px;color:var(--c-text);">@total</span>
        <span style="font-size:12px;color:var(--c-muted);">Listed</span>
    </div>
    <div class="stat-pill d-flex align-items-center gap-2">
        <span class="stat-pill-dot" style="background:#10b981;"></span>
        <span class="fw-700" style="font-size:13px;color:var(--c-text);">@active</span>
        <span style="font-size:12px;color:var(--c-muted);">Active</span>
    </div>
    <div class="stat-pill d-flex align-items-center gap-2">
        <span class="stat-pill-dot" style="background:var(--c-muted);"></span>
        <span class="fw-700" style="font-size:13px;color:var(--c-text);">@inactive</span>
        <span style="font-size:12px;color:var(--c-muted);">Inactive</span>
    </div>
</div>

<form asp-action="Courses" method="get" class="surface p-3 mb-4 anim-fade-up-1">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="searchTerm">Search</label>
            <input id="searchTerm" name="searchTerm" value="@searchTerm" class="form-control"
                   placeholder="Course code or name" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="departmentId">Department</label>
            <select id="departmentId" name="departmentId" class="form-select" asp-items="ViewBag.FilterDepartmentId">
                <option value="">All departments</option>
            </select>
        </div>
        <div class="col-md-3">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="includeInactive" name="includeInactive" value="true"
                @(includeInactive ? "checked" : null) />
                <label class="form-check-label" for="includeInactive">Include inactive</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Apply</button>
                <a asp-action="Courses" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </div>
    </div>
</form>

<div class="mb-3">
    @if (includeInactive)
    {
        <a asp-action="Courses" asp-route-searchTerm="@searchTerm" asp-route-departmentId="@selectedDepartmentId"
           class="btn btn-outline-secondary btn-sm">Active only</a>
    }
    else
    {
        <a asp-action="Courses" asp-route-searchTerm="@searchTerm" asp-route-departmentId="@selectedDepartmentId"
           asp-route-includeInactive="true" class="btn btn-outline-secondary btn-sm">Include inactive</a>
    }
</div>

@if (total > 0)
{
    <div class="surface anim-fade-up-2 overflow-hidden" id="courses-table-wrap">
        <div class="table-responsive">
            <table class="table courses-table mb-0">
                <thead>
                    <tr>
                        <th class="col-code">Code</th>
                        <th class="col-name">Name</th>
                        <th class="col-credits text-center">Cr.</th>
                        <th class="col-type">Type</th>
                        <th class="col-avail">Availability</th>
                        <th class="col-prereqs">Prerequisites</th>
                        <th class="col-status">Status</th>
                        <th class="col-actions text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in list)
                    {
                        var typeMeta = TypeMeta(item.CourseType);
                        var avail = AvailMeta(item.SemesterAvailability);
                        var prereqs = item.Prerequisites?.ToList() ?? new List<CoursePrerequisiteDto>();

                        <tr class="course-row">
                            <td class="col-code"><span class="course-code">@item.Code</span></td>
                            <td class="col-name"><span class="course-name">@item.Name</span></td>
                            <td class="col-credits text-center"><span class="credits-badge">@item.CreditHours</span></td>
                            <td class="col-type"><span class="type-badge @typeMeta.Css">@typeMeta.Label</span></td>
                            <td class="col-avail">
                                <span class="avail-badge @AvailClass(item.SemesterAvailability)">
                                    <span class="material-symbols-outlined"
                                          style="font-size:13px;font-variation-settings:'FILL' 0,'wght' 300">@avail.Icon</span>@avail.Label
                                </span>
                            </td>
                            <td class="col-prereqs">
                                @if (prereqs.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var p in prereqs.Take(3))
                                        {
                                            <span class="prereq-tag">@p.PrerequisiteCode</span>
                                        }
                                        @if (prereqs.Count > 3)
                                        {
                                            <span class="prereq-more">+@(prereqs.Count - 3)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="prereq-none">None</span>
                                }
                            </td>
                            <td class="col-status">
                                @if (item.IsActive)
                                {
                                    <span class="status-badge status-active"><span class="status-dot-sm"></span>Active</span>
                                }
                                else
                                {
                                    <span class="status-badge status-archived">Inactive</span>
                                }
                            </td>
                            <td class="col-actions text-end">
                                <a asp-action="CourseEdit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="CourseDeactivate" asp-route-id="@item.Id" asp-route-searchTerm="@searchTerm"
                                      asp-route-departmentId="@selectedDepartmentId" asp-route-includeInactive="@includeInactive"
                                      method="post" class="d-inline">
                                    <button type="submit"
                                            class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            onclick="return confirm('@(item.IsActive ? "Deactivate" : "Reactivate") this course?');">
                                        @(item.IsActive ? "Deactivate" : "Reactivate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 px-4 py-3"
             style="border-top:1px solid var(--c-border);">
            <p class="mb-0" style="font-size:12px;color:var(--c-muted);">
                Showing <span class="fw-700" style="color:var(--c-primary);">@total</span> course@(total == 1 ? "" : "s")
            </p>
        </div>
    </div>
}
else
{
    <div class="surface anim-fade-up-2 overflow-hidden text-center py-5 px-3">
        <span class="material-symbols-outlined d-block mb-3"
              style="font-size:40px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 200">search_off</span>
        <p class="fw-700 mb-1" style="font-size:14px;color:var(--c-text);">No courses match</p>
        <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Adjust search or department filters.</p>
    </div>
}
