@model StudentDetailDto

@{
    ViewData["Title"] = "Student Details";
}

<div class="d-flex flex-column gap-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3 anim-fade-up">
        <div>
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-0" style="font-size:12px;">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Students" style="color:var(--c-muted);text-decoration:none;">Students</a></li>
                    <li class="breadcrumb-item active" style="color:var(--c-primary);font-weight:600;">@Model.FullName</li>
                </ol>
            </nav>
            <h1 class="fw-900 mb-1" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Student Profile</h1>
            <p class="mb-0" style="font-size:13px;color:var(--c-muted);">@Model.Email · @(Model.DepartmentName ?? "No department")</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="AddCourse" asp-controller="Students" asp-route-studentId="@Model.StudentId" class="btn btn-primary">Add Course Record</a>
            <a asp-action="Index" asp-controller="Students" class="btn btn-outline-secondary">Back to Students</a>
        </div>
    </div>

    <partial name="_AdminAlerts" />

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="surface p-4 h-100">
                <h2 class="h5 mb-3">Academic Summary</h2>
                <dl class="mb-0">
                    <dt>Department</dt>
                    <dd>@(Model.DepartmentName ?? "-")</dd>
                    <dt>Academic Year</dt>
                    <dd>@(Model.AcademicYear ?? "-")</dd>
                    <dt>Semester</dt>
                    <dd>@Model.CurrentSemester</dd>
                    <dt>Standing</dt>
                    <dd>@Model.CurrentStanding</dd>
                </dl>
            </div>
        </div>
        <div class="col-12 col-lg-8">
            <div class="surface" style="overflow:hidden;">
                <div class="px-4 py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h2 class="h5 mb-0">Course Records</h2>
                    <span class="text-muted small">@Model.CourseRecords.Count record(s)</span>
                </div>
                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Course</th>
                                <th class="text-center">Credits</th>
                                <th class="text-center">Grade</th>
                                <th class="text-center">Semester</th>
                                <th class="text-center">Year</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CourseRecords.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">No course records yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var record in Model.CourseRecords)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-700">@record.CourseCode</div>
                                            <div class="text-muted small">@record.CourseName</div>
                                        </td>
                                        <td class="text-center">@record.CreditHours</td>
                                        <td class="text-center">@(record.Grade ?? "In Progress")</td>
                                        <td class="text-center">@record.Semester</td>
                                        <td class="text-center">@record.AcademicYear</td>
                                        <td>@record.Status</td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                <a asp-action="EditCourse" asp-controller="Students" asp-route-recordId="@record.RecordId" class="btn btn-sm btn-outline-primary">Edit</a>
                                                <form asp-action="DeleteCourse" asp-controller="Students" asp-route-recordId="@record.RecordId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="studentId" value="@Model.StudentId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this course record?');">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
