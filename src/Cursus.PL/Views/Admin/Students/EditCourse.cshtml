@model StudentCourseFormViewModel

@{
    ViewData["Title"] = "Edit Course Record";
}

<div class="d-flex flex-column gap-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3 anim-fade-up">
        <div>
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-0" style="font-size:12px;">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Students" style="color:var(--c-muted);text-decoration:none;">Students</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-controller="Students" asp-route-studentId="@Model.StudentId" style="color:var(--c-muted);text-decoration:none;">@Model.StudentName</a></li>
                    <li class="breadcrumb-item active" style="color:var(--c-primary);font-weight:600;">Edit Course Record</li>
                </ol>
            </nav>
            <h1 class="fw-900 mb-1" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Edit Course Record</h1>
            <p class="mb-0" style="font-size:13px;color:var(--c-muted);">@Model.DepartmentName</p>
        </div>
        <a asp-action="Details" asp-controller="Students" asp-route-studentId="@Model.StudentId" class="btn btn-outline-secondary">Back to Profile</a>
    </div>

    <partial name="_AdminAlerts" />

    <div class="surface p-4 p-md-5">
        <form asp-action="EditCourse" asp-controller="Students" asp-route-recordId="@Model.RecordId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="RecordId" />
            <input type="hidden" asp-for="StudentId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-4 mb-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Course</label>
                    <input class="form-control" value="@(Model.CourseDisplayName ?? "-")" disabled />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Semester</label>
                    <input class="form-control" value="@(Model.Semester?.ToString() ?? "-")" disabled />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Academic Year</label>
                    <input class="form-control" value="@Model.AcademicYear" disabled />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Department</label>
                    <input class="form-control" value="@(Model.DepartmentName ?? "-")" disabled />
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <label asp-for="Grade" class="form-label">Grade</label>
                    <select asp-for="Grade" class="form-select" asp-items="Model.GradeOptions">
                        <option value="">In Progress</option>
                    </select>
                    <span asp-validation-for="Grade" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StudentCourseStatus>()">
                        <option value="">Select status...</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Details" asp-controller="Students" asp-route-studentId="@Model.StudentId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
