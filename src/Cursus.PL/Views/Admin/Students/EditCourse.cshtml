@model Cursus.PL.Models.EditCourseRecordViewModel
@using Cursus.Domain.Enums
@{
    ViewData["Title"] = "Edit Course Record";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/students.css" asp-append-version="true"/>
}

<div class="mb-4 anim-fade-up">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="font-size:12px;">
            <li class="breadcrumb-item"><a asp-action="Students" style="color:var(--c-muted);text-decoration:none;">Students</a></li>
            <li class="breadcrumb-item"><a asp-action="StudentDetail" asp-route-id="@Model.StudentId" style="color:var(--c-muted);text-decoration:none;">@Model.StudentName</a></li>
            <li class="breadcrumb-item active" style="color:var(--c-primary);font-weight:600;">Edit Course Record</li>
        </ol>
    </nav>
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="fw-900 mb-1" style="font-size:1.6rem;letter-spacing:-.4px;color:var(--c-text);">Edit Course Record</h1>
            <p class="mb-0" style="font-size:13px;color:var(--c-muted);">
                Editing record for <strong style="color:var(--c-text);">@Model.StudentName</strong>
            </p>
        </div>
        <a asp-action="StudentDetail" asp-route-id="@Model.StudentId"
           class="btn d-flex align-items-center gap-2 fw-600 text-decoration-none"
           style="border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text);border-radius:12px;font-size:13px;padding:9px 16px;">
            <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">arrow_back</span>
            Back to Student
        </a>
    </div>
</div>

<partial name="_AdminAlerts"/>

<div class="surface p-4 p-md-5 anim-fade-up-1" style="max-width:680px;">

    <!-- Course identity (read-only) -->
    <div class="d-flex align-items-center gap-3 mb-4 pb-4" style="border-bottom:1px solid var(--c-border);">
        <div style="width:40px;height:40px;border-radius:12px;background:rgba(79,70,229,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <span class="material-symbols-outlined" style="font-size:20px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">edit_note</span>
        </div>
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="course-code">@Model.CourseCode</span>
                <h2 class="fw-800 mb-0" style="font-size:1.05rem;color:var(--c-text);">@Model.CourseName</h2>
            </div>
            <p class="mb-0" style="font-size:12px;color:var(--c-muted);">The course cannot be changed — create a new record instead.</p>
        </div>
    </div>

    <form asp-action="StudentEditCourse" method="post" novalidate>
        <input type="hidden" asp-for="RecordId"/>
        <input type="hidden" asp-for="StudentId"/>
        <input type="hidden" asp-for="StudentName"/>
        <input type="hidden" asp-for="CourseCode"/>
        <input type="hidden" asp-for="CourseName"/>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert" style="font-size:13px;border-radius:10px;"></div>

        <!-- Grade -->
        <div class="mb-4">
            <label asp-for="Grade" class="form-label fw-700" style="font-size:13px;color:var(--c-text);">
                Grade <span style="color:var(--c-muted);font-weight:400;">(optional — leave blank for In Progress)</span>
            </label>
            <select asp-for="Grade" asp-items="Model.GradeOptions"
                    class="form-select" id="grade-edit-select"
                    style="border-radius:10px;border:1px solid var(--c-border);background:var(--c-bg);color:var(--c-text);font-size:13px;padding:10px 14px;">
            </select>
            <span asp-validation-for="Grade" class="text-danger" style="font-size:12px;"></span>
            <p class="mt-1 mb-0" style="font-size:11.5px;color:var(--c-muted);">
                Providing a grade will auto-resolve status (≥ passing threshold → Completed, below → Failed).
                Override the auto-resolved status below if needed.
            </p>
        </div>

        <!-- Status override -->
        <div class="mb-4">
            <label asp-for="Status" class="form-label fw-700" style="font-size:13px;color:var(--c-text);">
                Status <span style="color:#ef4444;">*</span>
                <span style="color:var(--c-muted);font-weight:400;">(auto-set when grade is provided)</span>
            </label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<StudentCourseStatus>()"
                    class="form-select" id="status-select"
                    style="border-radius:10px;border:1px solid var(--c-border);background:var(--c-bg);color:var(--c-text);font-size:13px;padding:10px 14px;">
            </select>
            <span asp-validation-for="Status" class="text-danger" style="font-size:12px;"></span>
        </div>

        <!-- Semester + Academic Year (read-only display for context) -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6">
                <label class="form-label fw-700" style="font-size:13px;color:var(--c-text);">Semester</label>
                <div class="form-control" id="semester-display"
                     style="border-radius:10px;border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text-sub);font-size:13px;padding:10px 14px;cursor:default;">
                    @Model.Semester.ToString()
                </div>
                <input type="hidden" asp-for="Semester"/>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="AcademicYear" class="form-label fw-700" style="font-size:13px;color:var(--c-text);">
                    Academic Year <span style="color:#ef4444;">*</span>
                </label>
                <input asp-for="AcademicYear" class="form-control" id="academic-year-edit-input"
                       placeholder="e.g. 2024-2025"
                       style="border-radius:10px;border:1px solid var(--c-border);background:var(--c-bg);color:var(--c-text);font-size:13px;padding:10px 14px;"/>
                <span asp-validation-for="AcademicYear" class="text-danger" style="font-size:12px;"></span>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex align-items-center gap-3 pt-4" style="border-top:1px solid var(--c-border);">
            <button type="submit" id="submit-edit-course"
                    class="btn btn-primary fw-700 d-flex align-items-center gap-2"
                    style="border-radius:12px;font-size:13px;padding:10px 20px;box-shadow:0 4px 14px rgba(79,70,229,.25);">
                <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 400">save</span>
                Update Record
            </button>
            <a asp-action="StudentDetail" asp-route-id="@Model.StudentId"
               class="btn fw-600 text-decoration-none"
               style="border:1px solid var(--c-border);background:transparent;color:var(--c-text-sub);border-radius:12px;font-size:13px;padding:10px 18px;">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script>
    // When a grade is selected, mirror it to the status select as a convenience hint.
    // The server always resolves the final status authoritatively.
    (function () {
        const gradeMap = {
            "A+": 0, "A": 0, "A-": 0,
            "B+": 0, "B": 0, "B-": 0,
            "C+": 0, "C": 0, "C-": 0,
            "D+": 0, "D": 0,
            "D-": 1, "F": 1
        };
        const gradeSelect  = document.getElementById("grade-edit-select");
        const statusSelect = document.getElementById("status-select");
        if (!gradeSelect || !statusSelect) return;

        gradeSelect.addEventListener("change", function () {
            const g = this.value;
            if (g === "") {
                statusSelect.value = "2"; // InProgress
            } else if (g in gradeMap) {
                statusSelect.value = String(gradeMap[g]);
            }
        });
    })();
    </script>
}
