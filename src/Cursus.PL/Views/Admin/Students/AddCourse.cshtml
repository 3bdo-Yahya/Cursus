@model StudentCourseFormViewModel

@{
    ViewData["Title"] = "Add Course Record";
}

<div class="d-flex flex-column gap-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3 anim-fade-up">
        <div>
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-0" style="font-size:12px;">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Students" style="color:var(--c-muted);text-decoration:none;">Students</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-controller="Students" asp-route-studentId="@Model.StudentId" style="color:var(--c-muted);text-decoration:none;">@Model.StudentName</a></li>
                    <li class="breadcrumb-item active" style="color:var(--c-primary);font-weight:600;">Add Course Record</li>
                </ol>
            </nav>
            <h1 class="fw-900 mb-1" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Add Course Record</h1>
            <p class="mb-0" style="font-size:13px;color:var(--c-muted);">@Model.DepartmentName</p>
        </div>
        <a asp-action="Details" asp-controller="Students" asp-route-studentId="@Model.StudentId" class="btn btn-outline-secondary">Back to Profile</a>
    </div>

    <partial name="_AdminAlerts" />

    <div class="surface p-4 p-md-5">
        <form asp-action="AddCourse" asp-controller="Students" asp-route-studentId="@Model.StudentId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StudentId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <label asp-for="CourseId" class="form-label">Course</label>
                    <select asp-for="CourseId" class="form-select" asp-items="Model.CourseOptions">
                        <option value="">Select course...</option>
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Grade" class="form-label">Grade</label>
                    <select asp-for="Grade" class="form-select" asp-items="Model.GradeOptions">
                        <option value="">In Progress</option>
                    </select>
                    <span asp-validation-for="Grade" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Semester" class="form-label"></label>
                    <select asp-for="Semester" class="form-select" asp-items="Html.GetEnumSelectList<SemesterType>()">
                        <option value="">Select semester...</option>
                    </select>
                    <span asp-validation-for="Semester" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="AcademicYear" class="form-label"></label>
                    <input asp-for="AcademicYear" class="form-control" placeholder="2025-2026" />
                    <span asp-validation-for="AcademicYear" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Details" asp-controller="Students" asp-route-studentId="@Model.StudentId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
