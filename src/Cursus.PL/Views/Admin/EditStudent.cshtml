@{
    ViewData["Title"] = "Edit Student";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/courses.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/students.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/add-course.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/add-student.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/edit-student.css" asp-append-version="true"/>
}

<div class="mb-4 anim-fade-up">
        <nav aria-label="breadcrumb" class="mb-2">
          <ol class="breadcrumb mb-0" style="font-size:12px;">
            <li class="breadcrumb-item"><a href="/Admin/Students" style="color:var(--c-muted);text-decoration:none;">Students</a></li>
            <li class="breadcrumb-item active" style="color:var(--c-primary);font-weight:600;">Edit Student</li>
          </ol>
        </nav>
        <h1 class="fw-900 mb-1" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Edit Student</h1>
        <p class="mb-0" style="font-size:13px;color:var(--c-muted);">Update profile and academic assignment for an existing student.</p>
      </div>

      <form id="edit-student-form" novalidate>
        <div id="update-feedback" class="student-success-alert d-none anim-fade-up-1" role="status" aria-live="polite"></div>

        <div class="surface p-4 p-md-5 mb-3 anim-fade-up-1">
          <div class="row g-4">
            <div class="col-12 col-md-6">
              <div class="form-group-fancy" id="fg-fullname">
                <label class="form-label-fancy" for="student-fullname">Full Name <span style="color:#dc2626;">*</span></label>
                <div class="input-wrap">
                  <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;">badge</span></span>
                  <input type="text" id="student-fullname" class="form-control fancy-input has-prefix" value="Ahmed Kamal"/>
                </div>
                <p class="field-error" id="err-fullname">Full name is required</p>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="form-group-fancy" id="fg-email">
                <label class="form-label-fancy" for="student-email">Email Address <span style="color:#dc2626;">*</span></label>
                <div class="input-wrap">
                  <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;">mail</span></span>
                  <input type="email" id="student-email" class="form-control fancy-input has-prefix" value="ahmed.kamal@svu.edu.eg"/>
                </div>
                <p class="field-error" id="err-email">A valid email address is required</p>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="form-group-fancy" id="fg-password">
                <label class="form-label-fancy" for="student-password">Temporary Password <span style="color:#dc2626;">*</span></label>
                <div class="input-wrap">
                  <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;">lock</span></span>
                  <input type="password" id="student-password" class="form-control fancy-input has-prefix" value="TempPass#2026" style="padding-right:44px;"/>
                  <button type="button" class="pass-toggle-btn" onclick="togglePassword()">
                    <span class="material-symbols-outlined" id="pass-toggle-icon" style="font-size:18px;">visibility</span>
                  </button>
                </div>
                <p class="field-error" id="err-password">Password must be at least 8 characters</p>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="form-group-fancy" id="fg-university">
                <label class="form-label-fancy">University <span style="color:#dc2626;">*</span></label>
                <div class="custom-select-wrap" id="stud-uni-wrap" style="display:block;">
                  <button type="button" class="custom-select-btn fancy-input" id="stud-uni-btn" style="height:40px;" onclick="toggleDropdown('stud-uni')">
                    <span class="custom-select-icon"><span class="material-symbols-outlined" style="font-size:16px;">account_balance</span></span>
                    <span class="custom-select-value" id="stud-uni-value">South Valley University</span>
                    <span class="material-symbols-outlined custom-select-arrow" style="font-size:16px;">expand_more</span>
                  </button>
                  <div class="custom-dropdown" id="stud-uni-dropdown">
                    <div class="custom-dropdown-item selected" data-value="svu" onclick="selectStudentUni(this)"><span class="custom-dropdown-check material-symbols-outlined" style="font-size:15px;">check_circle</span><div><div class="custom-dropdown-label">South Valley University</div></div></div>
                    <div class="custom-dropdown-item" data-value="auc" onclick="selectStudentUni(this)"><span class="custom-dropdown-check material-symbols-outlined" style="font-size:15px;">check_circle</span><div><div class="custom-dropdown-label">American University in Cairo</div></div></div>
                    <div class="custom-dropdown-item" data-value="su" onclick="selectStudentUni(this)"><span class="custom-dropdown-check material-symbols-outlined" style="font-size:15px;">check_circle</span><div><div class="custom-dropdown-label">Sinai University</div></div></div>
                  </div>
                  <select id="student-university" class="d-none" aria-hidden="true" tabindex="-1">
                    <option value="">Select university</option>
                    <option value="svu" selected>South Valley University</option>
                    <option value="auc">American University in Cairo</option>
                    <option value="su">Sinai University</option>
                  </select>
                </div>
                <p class="field-error" id="err-university">Please select a university</p>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="form-group-fancy" id="fg-department">
                <label class="form-label-fancy">Department <span style="color:#dc2626;">*</span></label>
                <div class="custom-select-wrap" id="stud-dept-wrap" style="display:block;">
                  <button type="button" class="custom-select-btn fancy-input" id="stud-dept-btn" style="height:40px;" onclick="toggleDropdown('stud-dept')">
                    <span class="custom-select-icon dept-icon-cs" id="stud-dept-icon-el"><span class="material-symbols-outlined" style="font-size:16px;">computer</span></span>
                    <span class="custom-select-value" id="stud-dept-value">Computer Science</span>
                    <span class="material-symbols-outlined custom-select-arrow" style="font-size:16px;">expand_more</span>
                  </button>
                  <div class="custom-dropdown" id="stud-dept-dropdown"></div>
                </div>
                <p class="field-error" id="err-department">Please select a department</p>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="form-group-fancy" id="fg-acyear">
                <label class="form-label-fancy" for="student-acyear">Academic Year <span style="color:#dc2626;">*</span></label>
                <div class="input-wrap">
                  <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;">calendar_today</span></span>
                  <input type="text" id="student-acyear" class="form-control fancy-input has-prefix" value="2025-2026"/>
                </div>
                <p class="field-error" id="err-acyear">Academic year is required</p>
              </div>
            </div>
          </div>
        </div>

        <div class="d-flex align-items-center justify-content-between gap-3 anim-fade-up-2 student-edit-actions">
          <a href="/Admin/Students" class="btn-step-back text-decoration-none"><span class="material-symbols-outlined" style="font-size:16px;">close</span>Cancel</a>
          <button type="button" class="btn-submit" id="update-student-btn"><span class="material-symbols-outlined" style="font-size:18px;">save</span>Update Student</button>
        </div>
      </form>

      <div id="update-success-state" class="d-none text-center anim-fade-up">
        <div class="surface p-5">
          <div class="success-ring mx-auto mb-4">
            <span class="material-symbols-outlined" style="font-size:36px;color:#059669;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
          </div>
          <h2 class="fw-900 mb-2" style="font-size:1.4rem;color:var(--c-text);">Student Updated!</h2>
          <p class="mb-4" style="font-size:14px;color:var(--c-muted);">
            <strong id="update-success-name" style="color:var(--c-primary);"></strong> has been updated in the system.
          </p>
          <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/Admin/Students" class="btn btn-primary fw-700 d-flex align-items-center gap-2 text-decoration-none"
               style="border-radius:12px;font-size:13px;padding:10px 20px;box-shadow:0 4px 14px rgba(79,70,229,.28);">
              <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">group</span>
              View All Students
            </a>
            <button onclick="resetEditStudentForm()" class="btn fw-600 d-flex align-items-center gap-2"
                    style="border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text);border-radius:12px;font-size:13px;padding:10px 20px;">
              <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">edit</span>
              Edit Again
            </button>
          </div>
        </div>
      </div>
@section Scripts {
    <script src="~/js/pages/admin/courses.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin/form-helpers.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin/edit-student.js" asp-append-version="true"></script>
}
