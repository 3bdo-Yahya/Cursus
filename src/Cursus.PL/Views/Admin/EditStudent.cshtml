@model Cursus.PL.Models.EditStudentViewModel
@using Cursus.Domain.Enums
@{
    ViewData["Title"] = "Edit Student";
    var initials = string.Join("", Model.DisplayName.Split(' ').Take(2).Select(p => p.FirstOrDefault()));
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/courses.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/students.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/edit-student.css" asp-append-version="true"/>
}

<!-- ── Breadcrumb + header ─────────────────────────────────────────────── -->
<div class="mb-4 anim-fade-up">
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-0" style="font-size:12px;">
            <li class="breadcrumb-item"><a asp-action="Students" style="color:var(--c-muted);text-decoration:none;">Students</a></li>
            <li class="breadcrumb-item">
                <a asp-action="StudentDetail" asp-route-id="@Model.Id" style="color:var(--c-muted);text-decoration:none;">@Model.DisplayName</a>
            </li>
            <li class="breadcrumb-item active" style="color:var(--c-primary);font-weight:600;">Edit</li>
        </ol>
    </nav>
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="fw-900 mb-1" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Edit Student</h1>
            <p class="mb-0" style="font-size:13px;color:var(--c-muted);">Update academic assignment for <strong style="color:var(--c-text);">@Model.DisplayName</strong></p>
        </div>
        <a asp-action="StudentDetail" asp-route-id="@Model.Id"
           class="btn d-flex align-items-center gap-2 fw-600 text-decoration-none"
           style="border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text);border-radius:12px;font-size:13px;padding:9px 16px;">
            <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">arrow_back</span>
            Back
        </a>
    </div>
</div>

<partial name="_AdminAlerts"/>

<form asp-action="EditStudent" method="post" novalidate>
    <input type="hidden" asp-for="Id"/>
    <input type="hidden" asp-for="DisplayName"/>
    <input type="hidden" asp-for="Email"/>
    @Html.AntiForgeryToken()

    <!-- ── Identity card (read-only) ──────────────────────────────────── -->
    <div class="surface p-4 mb-4 anim-fade-up-1 d-flex align-items-center gap-4">
        <div class="vs-avatar-lg" style="background:rgba(79,70,229,.12);color:var(--c-primary);flex-shrink:0;">@initials</div>
        <div>
            <p class="fw-800 mb-1" style="font-size:1.1rem;color:var(--c-text);">@Model.DisplayName</p>
            <p class="mb-0" style="font-size:12.5px;color:var(--c-muted);">@Model.Email</p>
        </div>
        <div class="ms-auto">
            <span class="stat-pill" style="font-size:11.5px;">Identity is managed by ASP.NET Core Identity — not editable here</span>
        </div>
    </div>

    <!-- ── Academic assignment ─────────────────────────────────────────── -->
    <div class="surface p-4 p-md-5 anim-fade-up-1" style="max-width:700px;">

        <div class="d-flex align-items-center gap-3 mb-4 pb-4" style="border-bottom:1px solid var(--c-border);">
            <div style="width:40px;height:40px;border-radius:12px;background:rgba(79,70,229,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <span class="material-symbols-outlined" style="font-size:20px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">school</span>
            </div>
            <div>
                <h2 class="fw-800 mb-0" style="font-size:1rem;color:var(--c-text);">Academic Assignment</h2>
                <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Department, year, semester, and standing.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert" style="font-size:13px;border-radius:10px;"></div>

        <div class="row g-4">

            <!-- Department -->
            <div class="col-12">
                <label asp-for="DepartmentId" class="form-label fw-700" style="font-size:13px;color:var(--c-text);">
                    Department <span style="color:#ef4444;">*</span>
                </label>
                <select asp-for="DepartmentId" asp-items="Model.DepartmentOptions"
                        class="form-select" id="dept-select"
                        style="border-radius:10px;border:1px solid var(--c-border);background:var(--c-bg);color:var(--c-text);font-size:13px;padding:10px 14px;">
                    <option value="0">— Select a department —</option>
                </select>
                <span asp-validation-for="DepartmentId" class="text-danger" style="font-size:12px;"></span>
            </div>

            <!-- Academic Year -->
            <div class="col-12 col-sm-4">
                <label asp-for="AcademicYear" class="form-label fw-700" style="font-size:13px;color:var(--c-text);">
                    Year of Study <span style="color:#ef4444;">*</span>
                </label>
                <input asp-for="AcademicYear" class="form-control" id="acyear-input"
                       placeholder="e.g. 2" maxlength="1"
                       style="border-radius:10px;border:1px solid var(--c-border);background:var(--c-bg);color:var(--c-text);font-size:13px;padding:10px 14px;"/>
                <span asp-validation-for="AcademicYear" class="text-danger" style="font-size:12px;"></span>
                <p class="mt-1 mb-0" style="font-size:11.5px;color:var(--c-muted);">Enter a number from 1 to 6.</p>
            </div>

            <!-- Semester -->
            <div class="col-12 col-sm-4">
                <label asp-for="CurrentSemester" class="form-label fw-700" style="font-size:13px;color:var(--c-text);">
                    Current Semester <span style="color:#ef4444;">*</span>
                </label>
                <select asp-for="CurrentSemester" asp-items="Model.SemesterOptions"
                        class="form-select" id="semester-select"
                        style="border-radius:10px;border:1px solid var(--c-border);background:var(--c-bg);color:var(--c-text);font-size:13px;padding:10px 14px;">
                </select>
                <span asp-validation-for="CurrentSemester" class="text-danger" style="font-size:12px;"></span>
            </div>

            <!-- Academic Standing -->
            <div class="col-12 col-sm-4">
                <label asp-for="CurrentStanding" class="form-label fw-700" style="font-size:13px;color:var(--c-text);">
                    Academic Standing <span style="color:#ef4444;">*</span>
                </label>
                <select asp-for="CurrentStanding" asp-items="Model.StandingOptions"
                        class="form-select" id="standing-select"
                        style="border-radius:10px;border:1px solid var(--c-border);background:var(--c-bg);color:var(--c-text);font-size:13px;padding:10px 14px;">
                </select>
                <span asp-validation-for="CurrentStanding" class="text-danger" style="font-size:12px;"></span>
            </div>

            <!-- Enrollment Date -->
            <div class="col-12 col-sm-4">
                <label asp-for="EnrollmentDate" class="form-label fw-700" style="font-size:13px;color:var(--c-text);">
                    Enrollment Date
                </label>
                <input asp-for="EnrollmentDate" type="date" class="form-control"
                       style="border-radius:10px;border:1px solid var(--c-border);background:var(--c-bg);color:var(--c-text);font-size:13px;padding:10px 14px;"/>
                <span asp-validation-for="EnrollmentDate" class="text-danger" style="font-size:12px;"></span>
                <p class="mt-1 mb-0" style="font-size:11.5px;color:var(--c-muted);">When the student started their program.</p>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex align-items-center gap-3 mt-4 pt-4" style="border-top:1px solid var(--c-border);">
            <button type="submit" id="update-student-btn"
                    class="btn btn-primary fw-700 d-flex align-items-center gap-2"
                    style="border-radius:12px;font-size:13px;padding:10px 20px;box-shadow:0 4px 14px rgba(79,70,229,.25);">
                <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 400">save</span>
                Update Student
            </button>
            <a asp-action="StudentDetail" asp-route-id="@Model.Id"
               class="btn fw-600 text-decoration-none"
               style="border:1px solid var(--c-border);background:transparent;color:var(--c-text-sub);border-radius:12px;font-size:13px;padding:10px 18px;">
                Cancel
            </a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
