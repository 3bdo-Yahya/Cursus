</div>
<!-- ── Edit Modal ──────────────────────────────────────── -->
<div id="edit-modal" class="sp-modal-overlay" onclick="closeEditModal(event)">
  <div class="sp-modal">
    <div class="sp-modal-header">
      <h3 class="fw-800 mb-0" style="font-size:15px;color:var(--c-text);">Edit Admin Profile</h3>
      <button class="sp-modal-close" onclick="closeEditModal()">
        <span class="material-symbols-outlined" style="font-size:20px;font-variation-settings:'FILL' 0,'wght' 300">close</span>
      </button>
    </div>
    <div class="sp-modal-body">
      <div class="row g-3">
        <div class="col-12 col-sm-6">
          <label class="sp-label">Full Name</label>
          <input type="text" class="sp-input" value="Dr. Mona Hassan Ibrahim">
        </div>
        <div class="col-12 col-sm-6">
          <label class="sp-label">Office Phone</label>
          <input type="text" class="sp-input" value="+20 96 512 3456">
        </div>
        <div class="col-12">
          <label class="sp-label">Email Address</label>
          <input type="email" class="sp-input" value="mona.hassan@svu.edu">
        </div>
        <div class="col-12 col-sm-6">
          <label class="sp-label">Office Location</label>
          <input type="text" class="sp-input" value="Faculty Building B, Room 214">
        </div>
        <div class="col-12 col-sm-6">
          <label class="sp-label">Office Hours</label>
          <input type="text" class="sp-input" value="Sun &amp; Tue, 10:00–13:00">
        </div>
      </div>
    </div>
    <div class="sp-modal-footer">
      <button class="sp-btn-ghost" onclick="closeEditModal()">Cancel</button>
      <button class="sp-btn-primary ap-btn" onclick="saveProfile()">
        <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">save</span>
        Save Changes
      </button>
    </div>
  </div>
</div>

<script>
function openEditModal() {
  document.getElementById('edit-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeEditModal(e) {
  if (e && e.target !== document.getElementById('edit-modal')) return;
  document.getElementById('edit-modal').classList.remove('open');
  document.body.style.overflow = '';
}
function saveProfile() { closeEditModal(); }

// Animate progress bars
requestAnimationFrame(() => {
  document.querySelectorAll('.ap-bar-fill').forEach(b => b.classList.add('animated'));
});
</script>
