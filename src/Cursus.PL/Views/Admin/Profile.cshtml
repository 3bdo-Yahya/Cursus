            <p class="sp-field-label">Staff ID</p>
            <p class="sp-field-value">SVU-STAFF-0042</p>
          </div>
          <div class="sp-field">
            <p class="sp-field-label">Email Address</p>
            <p class="sp-field-value">mona.hassan@svu.edu</p>
          </div>
          <div class="sp-field">
            <p class="sp-field-label">Office Phone</p>
            <p class="sp-field-value">+20 96 512 3456</p>
          </div>
          <div class="sp-field">
            <p class="sp-field-label">Office Location</p>
            <p class="sp-field-value">Faculty Building B, Room 214</p>
          </div>
          <div class="sp-field">
            <p class="sp-field-label">Office Hours</p>
            <p class="sp-field-value">Sun & Tue, 10:00–13:00</p>
          </div>
        </div>
      </div>

      <!-- Role & Permissions -->
