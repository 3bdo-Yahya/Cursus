                <span class="fw-700" style="font-size:13px;color:var(--c-text);">142 active</span>
                <span style="font-size:11px;color:#10b981;font-weight:700;">+14 this semester</span>
              </div>
              <div class="ap-bar-track">
                <div class="ap-bar-fill" style="--w:71%;background:var(--c-primary);"></div>
              </div>
            </div>
            <div class="ap-dept-row">
              <p class="sp-field-label mb-1">Good Standing Rate</p>
              <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="fw-700" style="font-size:13px;color:var(--c-text);">114 students</span>
                <span style="font-size:11px;color:#10b981;font-weight:700;">80.3%</span>
              </div>
              <div class="ap-bar-track">
                <div class="ap-bar-fill" style="--w:80%;background:#10b981;"></div>
              </div>
            </div>
            <div class="ap-dept-row">
              <p class="sp-field-label mb-1">Avg. Department GPA</p>
              <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="fw-700" style="font-size:13px;color:var(--c-text);">2.91 / 4.0</span>
                <span style="font-size:11px;color:#d97706;font-weight:700;">72.8%</span>
              </div>
              <div class="ap-bar-track">
                <div class="ap-bar-fill" style="--w:72.8%;background:#d97706;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Recent Activity -->
        <div class="sp-card">
          <div class="sp-card-header">
            <div class="d-flex align-items-center gap-2">
              <div class="sp-card-icon" style="background:var(--tile-green-bg);">
                <span class="material-symbols-outlined" style="font-size:17px;color:#10b981;font-variation-settings:'FILL' 0,'wght' 300">history</span>
