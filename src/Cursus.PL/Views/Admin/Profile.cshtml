            <div class="d-flex align-items-center gap-3">
              <div class="sp-security-icon">
                <span class="material-symbols-outlined" style="font-size:18px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">password</span>
              </div>
              <div>
                <p class="fw-700 mb-0" style="font-size:13px;color:var(--c-text);">Password</p>
                <p class="mb-0" style="font-size:11.5px;color:var(--c-muted);">Last changed 1 month ago</p>
              </div>
            </div>
            <button class="sp-edit-btn">Change</button>
          </div>
          <div class="sp-security-row">
            <div class="d-flex align-items-center gap-3">
              <div class="sp-security-icon">
                <span class="material-symbols-outlined" style="font-size:18px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">notifications_active</span>
