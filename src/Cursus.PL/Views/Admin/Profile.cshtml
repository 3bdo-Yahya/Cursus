              <div class="ap-activity-dot" style="background:#10b981;"></div>
              <div>
                <p class="fw-600 mb-0" style="font-size:12.5px;color:var(--c-text);">Grades entered for CS211 — 28 students</p>
                <p class="mb-0" style="font-size:11px;color:var(--c-muted);">Today, 11:24 AM</p>
              </div>
            </div>
            <div class="ap-activity-row">
              <div class="ap-activity-dot" style="background:var(--c-primary);"></div>
              <div>
                <p class="fw-600 mb-0" style="font-size:12.5px;color:var(--c-text);">New course AI413 added to catalog</p>
                <p class="mb-0" style="font-size:11px;color:var(--c-muted);">Yesterday, 2:15 PM</p>
              </div>
            </div>
            <div class="ap-activity-row">
              <div class="ap-activity-dot" style="background:#d97706;"></div>
              <div>
                <p class="fw-600 mb-0" style="font-size:12.5px;color:var(--c-text);">CS201 failure rate alert acknowledged</p>
                <p class="mb-0" style="font-size:11px;color:var(--c-muted);">Yesterday, 9:03 AM</p>
              </div>
            </div>
            <div class="ap-activity-row">
              <div class="ap-activity-dot" style="background:var(--c-primary);"></div>
              <div>
                <p class="fw-600 mb-0" style="font-size:12.5px;color:var(--c-text);">Prerequisite updated: AI301 → CS311</p>
                <p class="mb-0" style="font-size:11px;color:var(--c-muted);">3 days ago</p>
              </div>
            </div>
            <div class="ap-activity-row" style="border-bottom:none;">
              <div class="ap-activity-dot" style="background:#10b981;"></div>
              <div>
                <p class="fw-600 mb-0" style="font-size:12.5px;color:var(--c-text);">14 new students enrolled and assigned</p>
                <p class="mb-0" style="font-size:11px;color:var(--c-muted);">5 days ago</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Admin Links -->
        <div class="sp-card">
          <div class="sp-card-header">
            <div class="d-flex align-items-center gap-2">
              <div class="sp-card-icon" style="background:var(--icon-amber-bg);">
                <span class="material-symbols-outlined" style="font-size:17px;color:#d97706;font-variation-settings:'FILL' 0,'wght' 300">grid_view</span>
              </div>
              <h3 class="sp-card-title">Quick Admin Links</h3>
            </div>
          </div>
          <div class="d-flex flex-column gap-2 mt-2">
            <a href="/Admin/Courses"   class="sp-quick-link">
              <span class="material-symbols-outlined sp-ql-icon" style="color:var(--c-primary);">menu_book</span>
