          </div>
        </div>
        <div class="d-flex flex-column gap-2">
          <div class="ap-perm-row ap-perm-on">
            <span class="material-symbols-outlined" style="font-size:17px;color:#10b981;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
            <div class="flex-fill">
              <p class="fw-700 mb-0" style="font-size:13px;color:var(--c-text);">Course Catalog Management</p>
              <p class="mb-0" style="font-size:11.5px;color:var(--c-muted);">Create, edit, and deactivate courses</p>
            </div>
          </div>
          <div class="ap-perm-row ap-perm-on">
            <span class="material-symbols-outlined" style="font-size:17px;color:#10b981;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
            <div class="flex-fill">
              <p class="fw-700 mb-0" style="font-size:13px;color:var(--c-text);">Student Grade Entry</p>
              <p class="mb-0" style="font-size:11.5px;color:var(--c-muted);">Record and update student grades</p>
            </div>
          </div>
          <div class="ap-perm-row ap-perm-on">
            <span class="material-symbols-outlined" style="font-size:17px;color:#10b981;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
            <div class="flex-fill">
              <p class="fw-700 mb-0" style="font-size:13px;color:var(--c-text);">Prerequisite Configuration</p>
              <p class="mb-0" style="font-size:11.5px;color:var(--c-muted);">Define and modify prerequisite chains</p>
            </div>
          </div>
          <div class="ap-perm-row ap-perm-on">
            <span class="material-symbols-outlined" style="font-size:17px;color:#10b981;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
            <div class="flex-fill">
              <p class="fw-700 mb-0" style="font-size:13px;color:var(--c-text);">Graduation Requirements</p>
              <p class="mb-0" style="font-size:11.5px;color:var(--c-muted);">Configure degree completion rules</p>
            </div>
          </div>
          <div class="ap-perm-row ap-perm-off">
            <span class="material-symbols-outlined" style="font-size:17px;color:var(--c-border);font-variation-settings:'FILL' 1,'wght' 400">cancel</span>
            <div class="flex-fill">
              <p class="fw-700 mb-0" style="font-size:13px;color:var(--c-muted);">Super Admin Access</p>
              <p class="mb-0" style="font-size:11.5px;color:var(--c-muted);">University-level settings — not granted</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Security -->
      <div class="sp-card">
        <div class="sp-card-header">
          <div class="d-flex align-items-center gap-2">
            <div class="sp-card-icon" style="background:var(--icon-blue-bg);">
