              <span>Manage Students</span>
              <span class="material-symbols-outlined ms-auto" style="font-size:16px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">chevron_right</span>
            </a>
            <a href="/Admin/AddCourse" class="sp-quick-link">
              <span class="material-symbols-outlined sp-ql-icon" style="color:#7c3aed;">add_circle</span>
              <span>Add New Course</span>
              <span class="material-symbols-outlined ms-auto" style="font-size:16px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">chevron_right</span>
            </a>
