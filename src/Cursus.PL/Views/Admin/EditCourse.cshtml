@{
    ViewData["Title"] = "Edit Course";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/add-course.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/edit-course.css" asp-append-version="true"/>
}

<!-- Header -->
    <div class="mb-4 anim-fade-up">
      <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-0" style="font-size:12px;">
          <li class="breadcrumb-item"><a href="/Admin/Courses" style="color:var(--c-muted);text-decoration:none;">Courses</a></li>
          <li class="breadcrumb-item active" style="color:var(--c-primary);font-weight:600;">Edit Course</li>
        </ol>
      </nav>
      <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <h1 class="fw-900 mb-0" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Edit Course</h1>
            <!-- Course badge — populated by JS from URL param or static for demo -->
            <span class="edit-course-badge" id="header-course-code">CS201</span>
          </div>
          <p class="mb-0" style="font-size:13px;color:var(--c-muted);">
            <span id="header-course-name">Data Structures &amp; Algorithms</span>
            &nbsp;·&nbsp; Last modified <span style="color:var(--c-text-sub);">Mar 14, 2026</span>
          </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <button class="btn d-flex align-items-center gap-2 fw-600"
                  style="border:1px solid rgba(239,68,68,.3);background:rgba(239,68,68,.05);color:#dc2626;border-radius:12px;font-size:13px;padding:8px 14px;"
                  onclick="confirmArchive()">
            <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">archive</span>
            Archive
          </button>
          <a href="/Admin/Courses" class="btn d-flex align-items-center gap-2 fw-600"
             style="border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text);border-radius:12px;font-size:13px;padding:8px 16px;text-decoration:none;">
            <span class="material-symbols-outlined" style="font-size:17px;font-variation-settings:'FILL' 0,'wght' 300">arrow_back</span>
            Back
          </a>
        </div>
      </div>
    </div>

    <form id="edit-course-form" novalidate>
    <div id="unsaved-banner" class="unsaved-banner d-none anim-fade-up mb-3">
      <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">edit_note</span>
      <span style="font-size:13px;font-weight:600;">You have unsaved changes</span>
      <button class="btn-link-reset ms-auto" onclick="discardChanges()">Discard</button>
    </div>

    <!-- ─── Basic Info ───────────────────────────────────────── -->
    <div class="edit-section surface p-4 p-md-5 mb-3 anim-fade-up-1">
      <div class="step-panel-header mb-4">
        <div class="step-panel-icon">
          <span class="material-symbols-outlined" style="font-size:20px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">info</span>
        </div>
        <div>
          <h2 class="fw-800 mb-0" style="font-size:1.05rem;color:var(--c-text);">Basic Information</h2>
          <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Identity and categorization</p>
        </div>
      </div>

      <div class="row g-4">

        <div class="col-12 col-md-4">
          <div class="form-group-fancy" id="fg-code">
            <label class="form-label-fancy" for="course-code">
              Course Code <span style="color:#dc2626;">*</span>
            </label>
            <div class="input-wrap">
              <span class="input-prefix">
                <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">tag</span>
              </span>
              <input type="text" id="course-code" class="form-control fancy-input has-prefix"
                     value="CS201" maxlength="10"
                     oninput="this.value = this.value.toUpperCase(); markDirty()"/>
            </div>
            <p class="field-hint">Unique code within the department</p>
            <p class="field-error" id="err-code">Course code is required</p>
          </div>
        </div>

        <div class="col-12 col-md-8">
          <div class="form-group-fancy" id="fg-name">
            <label class="form-label-fancy" for="course-name">
              Course Name <span style="color:#dc2626;">*</span>
            </label>
            <div class="input-wrap">
              <span class="input-prefix">
                <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">menu_book</span>
              </span>
              <input type="text" id="course-name" class="form-control fancy-input has-prefix"
                     value="Data Structures &amp; Algorithms" maxlength="100"
                     oninput="markDirty()"/>
            </div>
            <p class="field-error" id="err-name">Course name is required</p>
          </div>
        </div>

        <div class="col-12 col-md-6">
          <div class="form-group-fancy" id="fg-dept">
            <label class="form-label-fancy" for="course-dept">
              Department <span style="color:#dc2626;">*</span>
            </label>
            <div class="input-wrap">
              <span class="input-prefix">
                <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">apartment</span>
              </span>
              <select id="course-dept" class="form-select fancy-input has-prefix" onchange="markDirty()">
                <option value="cs" selected>Computer Science</option>
                <option value="math">Mathematics</option>
                <option value="eng">Engineering</option>
                <option value="bus">Business</option>
              </select>
            </div>
            <p class="field-error" id="err-dept">Please select a department</p>
          </div>
        </div>

        <div class="col-12 col-md-6">
          <div class="form-group-fancy" id="fg-type">
            <label class="form-label-fancy" for="course-type">
              Course Type <span style="color:#dc2626;">*</span>
            </label>
            <div class="input-wrap">
              <span class="input-prefix">
                <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">category</span>
              </span>
              <select id="course-type" class="form-select fancy-input has-prefix" onchange="markDirty()">
                <option value="core" selected>Core</option>
                <option value="dept-elective">Department Elective</option>
                <option value="free-elective">Free Elective</option>
                <option value="university-req">University Requirement</option>
              </select>
            </div>
            <p class="field-error" id="err-type">Please select a course type</p>
          </div>
        </div>

        <div class="col-12">
          <div class="form-group-fancy">
            <label class="form-label-fancy" for="course-desc">Description</label>
            <textarea id="course-desc" class="form-control fancy-input fancy-textarea"
                      rows="3" oninput="markDirty()"
                      >Fundamental data structures including arrays, linked lists, stacks, queues, trees, heaps, and graphs. Algorithm analysis and complexity theory.</textarea>
          </div>
        </div>

      </div>
    </div>

    <!-- ─── Configuration ───────────────────────────────────────── -->
    <div class="edit-section surface p-4 p-md-5 mb-3 anim-fade-up-2">
      <div class="step-panel-header mb-4">
        <div class="step-panel-icon">
          <span class="material-symbols-outlined" style="font-size:20px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">tune</span>
        </div>
        <div>
          <h2 class="fw-800 mb-0" style="font-size:1.05rem;color:var(--c-text);">Configuration</h2>
          <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Credits, availability, and grading rules</p>
        </div>
      </div>

      <div class="row g-4">

        <div class="col-12 col-md-4">
          <div class="form-group-fancy" id="fg-credits">
            <label class="form-label-fancy" for="course-credits">Credit Hours <span style="color:#dc2626;">*</span></label>
            <div class="input-wrap">
              <span class="input-prefix">
                <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">exposure</span>
              </span>
              <input type="number" id="course-credits" class="form-control fancy-input has-prefix"
                     value="3" min="1" max="6" oninput="markDirty()"/>
            </div>
            <p class="field-error" id="err-credits">Credits must be between 1 and 6</p>
          </div>
        </div>

        <div class="col-12 col-md-8">
          <div class="form-group-fancy">
            <label class="form-label-fancy">Semester Availability <span style="color:#dc2626;">*</span></label>
            <div class="avail-selector d-flex gap-2 flex-wrap mt-1">
              <label class="avail-option">
                <input type="radio" name="avail" value="fall" hidden onchange="markDirty()"/>
                <span class="avail-label">
                  <span class="material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 0,'wght' 300">ac_unit</span>
                  Fall only
                </span>
              </label>
              <label class="avail-option">
                <input type="radio" name="avail" value="spring" hidden onchange="markDirty()"/>
                <span class="avail-label">
                  <span class="material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 0,'wght' 300">wb_sunny</span>
                  Spring only
                </span>
              </label>
              <label class="avail-option">
                <input type="radio" name="avail" value="both" hidden checked onchange="markDirty()"/>
                <span class="avail-label avail-label-checked">
                  <span class="material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 0,'wght' 300">event_repeat</span>
                  Fall & Spring
                </span>
              </label>
              <label class="avail-option">
                <input type="radio" name="avail" value="all" hidden onchange="markDirty()"/>
                <span class="avail-label">
                  <span class="material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 0,'wght' 300">calendar_month</span>
                  All Semesters
                </span>
              </label>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6">
          <div class="form-group-fancy">
            <label class="form-label-fancy" for="course-pass-grade">Passing Grade Threshold</label>
            <div class="input-wrap">
              <span class="input-prefix">
                <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">grade</span>
              </span>
              <select id="course-pass-grade" class="form-select fancy-input has-prefix" onchange="markDirty()">
                <option value="D" selected>D — Default (1.0)</option>
                <option value="D+">D+ (1.3)</option>
                <option value="C-">C- (1.7)</option>
                <option value="C">C (2.0) — For core courses</option>
                <option value="C+">C+ (2.3)</option>
              </select>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6">
          <div class="form-group-fancy">
            <label class="form-label-fancy" for="course-min-credits">
              Min. Completed Credits to Unlock
              <span class="optional-badge">optional</span>
            </label>
            <div class="input-wrap">
              <span class="input-prefix">
                <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">lock_open</span>
              </span>
              <input type="number" id="course-min-credits" class="form-control fancy-input has-prefix"
                     placeholder="e.g. 60" min="0" max="200" oninput="markDirty()"/>
            </div>
          </div>
        </div>

        <div class="col-12">
          <div class="surface p-3 d-flex align-items-center justify-content-between gap-3"
               style="border-radius:12px;border-color:rgba(79,70,229,.15);">
            <div>
              <p class="fw-700 mb-0" style="font-size:13px;color:var(--c-text);">Course Active Status</p>
              <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Inactive courses are hidden from students but remain in the database</p>
            </div>
            <div class="toggle-wrap">
              <input type="checkbox" id="course-active" class="toggle-input" checked onchange="markDirty()"/>
              <label for="course-active" class="toggle-label">
                <span class="toggle-knob"></span>
              </label>
              <span id="toggle-text" class="toggle-text" style="color:#059669;">Active</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ─── Prerequisites ───────────────────────────────────────── -->
    <div class="edit-section surface p-4 p-md-5 mb-4 anim-fade-up-3">
      <div class="step-panel-header mb-4">
        <div class="step-panel-icon">
          <span class="material-symbols-outlined" style="font-size:20px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">account_tree</span>
        </div>
        <div>
          <h2 class="fw-800 mb-0" style="font-size:1.05rem;color:var(--c-text);">Prerequisites</h2>
          <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Courses students must pass before taking this one</p>
        </div>
      </div>

      <!-- Impact warning (shown when prerequisites change) -->
      <div id="prereq-change-warn" class="d-none mb-3"
           style="padding:10px 14px;border-radius:10px;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.25);display:flex;align-items:center;gap:10px;">
        <span class="material-symbols-outlined" style="font-size:16px;color:#d97706;font-variation-settings:'FILL' 0,'wght' 400">warning</span>
        <span style="font-size:12px;color:#92400e;font-weight:600;">Changing prerequisites may affect students currently enrolled in dependent courses.</span>
      </div>

      <div class="prereq-search-wrap mb-3">
        <div class="input-wrap">
          <span class="input-prefix">
            <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">search</span>
          </span>
          <input type="text" id="prereq-search" class="form-control fancy-input has-prefix"
                 placeholder="Search courses to add as prerequisites…"
                 oninput="filterPrereqSearch(this.value)" autocomplete="off"/>
        </div>
        <div id="prereq-dropdown" class="prereq-dropdown surface d-none"></div>
      </div>

      <div id="selected-prereqs" class="prereq-chips-wrap">
        <span class="prereq-chip">
          CS101
          <button class="prereq-chip-remove" onclick="removePrereq('CS101')" title="Remove">×</button>
        </span>
        <span class="prereq-chip">
          MTH101
          <button class="prereq-chip-remove" onclick="removePrereq('MTH101')" title="Remove">×</button>
        </span>
        <div id="prereq-empty" style="display:none;" class="prereq-empty-state text-center py-4">
          <span class="material-symbols-outlined mb-2" style="font-size:32px;color:var(--c-border);font-variation-settings:'FILL' 0,'wght' 200;display:block;">account_tree</span>
          <p class="fw-600 mb-0" style="font-size:13px;color:var(--c-muted);">No prerequisites added</p>
          <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Search above to add prerequisite courses</p>
        </div>
      </div>

      <div class="mt-4 pt-3" style="border-top:1px solid var(--c-border);">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="fw-700" style="font-size:13px;color:var(--c-text);">Corequisites</span>
          <span class="optional-badge">optional</span>
        </div>
        <div class="input-wrap">
          <span class="input-prefix">
            <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">sync_alt</span>
          </span>
          <input type="text" id="coreq-input" class="form-control fancy-input has-prefix"
                 placeholder="Type course codes separated by commas…" oninput="markDirty()"/>
        </div>
      </div>
    </div>

    <!-- ── Action Bar ── -->
    <div class="edit-action-bar anim-fade-up-3">
      <div class="d-flex align-items-center gap-2">
        <a href="/Admin/Courses" class="btn-step-back" style="text-decoration:none;">
          <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">close</span>
          Cancel
        </a>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span id="save-hint" class="save-hint">All changes will be applied immediately</span>
        <button type="button" class="btn-submit" id="save-btn" onclick="saveChanges()">
          <span class="material-symbols-outlined" style="font-size:17px;font-variation-settings:'FILL' 1,'wght' 400">save</span>
          Save Changes
        </button>
      </div>
    </div>
    </form>

  </div>
<!-- Archive -->
  <div id="archive-modal" class="modal-overlay d-none" onclick="if(event.target===this)closeArchiveModal()">
    <div class="modal-box surface p-4">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div style="width:40px;height:40px;border-radius:12px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <span class="material-symbols-outlined" style="font-size:20px;color:#dc2626;font-variation-settings:'FILL' 0,'wght' 400">archive</span>
        </div>
        <div>
          <p class="fw-800 mb-0" style="font-size:14px;color:var(--c-text);">Archive Course?</p>
          <p class="mb-0" style="font-size:12px;color:var(--c-muted);">This will hide the course from students</p>
        </div>
      </div>
      <p style="font-size:13px;color:var(--c-text-sub);margin-bottom:16px;">
        Archiving <strong id="modal-course-code">CS201</strong> will hide it from the active course catalog. Students currently enrolled will not be affected. You can restore it at any time.
      </p>
      <div class="d-flex justify-content-end gap-2">
        <button class="btn-step-back" onclick="closeArchiveModal()">Cancel</button>
        <button class="btn d-flex align-items-center gap-2 fw-700"
                style="border-radius:10px;font-size:13px;padding:9px 18px;background:#dc2626;border:none;color:#fff;"
                onclick="archiveCourse()">
          <span class="material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 0,'wght' 300">archive</span>
          Archive Course
        </button>
      </div>
    </div>
@section Scripts {
    <script src="~/js/pages/admin/form-helpers.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin/edit-course.js" asp-append-version="true"></script>
}
