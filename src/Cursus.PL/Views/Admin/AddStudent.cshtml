@using Cursus.Domain.Enums
@model Cursus.PL.Models.CreateStudentViewModel

@{
    ViewData["Title"] = "Add Student";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/courses.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/students.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/add-student.css" asp-append-version="true"/>
}

<!-- Breadcrumb + Header -->
<div class="mb-4 anim-fade-up">
  <nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0" style="font-size:12px;">
      <li class="breadcrumb-item"><a asp-action="Students" style="color:var(--c-muted);text-decoration:none;">Students</a></li>
      <li class="breadcrumb-item active" style="color:var(--c-primary);font-weight:600;">Add New Student</li>
    </ol>
  </nav>
  <div class="d-flex align-items-center justify-content-between gap-3">
    <div>
      <h1 class="fw-900 mb-1" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Add New Student</h1>
      <p class="mb-0" style="font-size:13px;color:var(--c-muted);">Register a new student and assign their academic profile. Fields marked <span style="color:#dc2626;">*</span> are required.</p>
    </div>
    <a asp-action="Students" class="btn d-flex align-items-center gap-2 fw-600 flex-shrink-0 text-decoration-none"
       style="border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text);border-radius:12px;font-size:13px;padding:8px 16px;">
      <span class="material-symbols-outlined" style="font-size:17px;font-variation-settings:'FILL' 0,'wght' 300">arrow_back</span>
      Back
    </a>
  </div>
</div>

<form asp-action="AddStudent" method="post" novalidate>
  @Html.AntiForgeryToken()

  <div asp-validation-summary="ModelOnly" class="alert alert-danger anim-fade-up-1" style="border-radius:12px;font-size:13px;display:none;" id="server-error-block"></div>

  <!-- ── Account Credentials ── -->
  <div class="surface p-4 p-md-5 mb-3 anim-fade-up-1">
    <div class="step-panel-header mb-4">
      <div class="step-panel-icon">
        <span class="material-symbols-outlined" style="font-size:20px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">person</span>
      </div>
      <div>
        <h2 class="fw-800 mb-0" style="font-size:1.05rem;color:var(--c-text);">Account Credentials</h2>
        <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Login details for the student portal</p>
      </div>
    </div>

    <div class="row g-4">
      <!-- Email -->
      <div class="col-12 col-md-6">
        <div class="form-group-fancy">
          <label asp-for="Email" class="form-label-fancy">Email Address <span style="color:#dc2626;">*</span></label>
          <div class="input-wrap">
            <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">mail</span></span>
            <input asp-for="Email" id="Email" class="form-control fancy-input has-prefix" placeholder="student@university.edu" />
          </div>
          <span asp-validation-for="Email" class="field-error" style="display:block;"></span>
        </div>
      </div>

      <!-- Temporary Password -->
      <div class="col-12 col-md-6">
        <div class="form-group-fancy">
          <label asp-for="Password" class="form-label-fancy">Temporary Password <span style="color:#dc2626;">*</span></label>
          <div class="input-wrap">
            <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">lock</span></span>
            <input asp-for="Password" id="Password" type="password" class="form-control fancy-input has-prefix" placeholder="Min. 8 characters" style="padding-right:44px;" />
            <button type="button" class="pass-toggle-btn" onclick="togglePasswordVisibility()" title="Show/hide password">
              <span class="material-symbols-outlined" id="pass-toggle-icon" style="font-size:18px;font-variation-settings:'FILL' 0,'wght' 300">visibility</span>
            </button>
          </div>
          <p class="field-hint">Student will be prompted to change this on first login</p>
          <span asp-validation-for="Password" class="field-error" style="display:block;"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Academic Information ── -->
  <div class="surface p-4 p-md-5 mb-4 anim-fade-up-2">
    <div class="step-panel-header mb-4">
      <div class="step-panel-icon">
        <span class="material-symbols-outlined" style="font-size:20px;color:var(--c-primary);font-variation-settings:'FILL' 1,'wght' 400">school</span>
      </div>
      <div>
        <h2 class="fw-800 mb-0" style="font-size:1.05rem;color:var(--c-text);">Academic Information</h2>
        <p class="mb-0" style="font-size:12px;color:var(--c-muted);">University placement and enrollment details</p>
      </div>
    </div>

    <div class="row g-4">

      <!-- Department -->
      <div class="col-12 col-md-6">
        <div class="form-group-fancy">
          <label asp-for="DepartmentId" class="form-label-fancy">Department <span style="color:#dc2626;">*</span></label>
          <div class="input-wrap" style="position:relative;">
            <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">apartment</span></span>
            <select asp-for="DepartmentId" asp-items="Model.DepartmentOptions"
                    class="form-select fancy-input has-prefix" style="border-radius:10px;height:40px;">
              <option value="">Select department…</option>
            </select>
          </div>
          <span asp-validation-for="DepartmentId" class="field-error" style="display:block;"></span>
        </div>
      </div>

      <!-- Current Semester -->
      <div class="col-12 col-md-6">
        <div class="form-group-fancy">
          <label asp-for="CurrentSemester" class="form-label-fancy">Current Semester <span style="color:#dc2626;">*</span></label>
          <div class="input-wrap">
            <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">today</span></span>
            <select asp-for="CurrentSemester" asp-items="Model.SemesterOptions"
                    class="form-select fancy-input has-prefix" style="border-radius:10px;height:40px;">
            </select>
          </div>
        </div>
      </div>

      <!-- Academic Year -->
      <div class="col-12 col-md-6">
        <div class="form-group-fancy">
          <label asp-for="AcademicYear" class="form-label-fancy">Academic Year <span style="color:#dc2626;">*</span></label>
          <div class="input-wrap">
            <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">calendar_today</span></span>
            <input asp-for="AcademicYear" class="form-control fancy-input has-prefix" placeholder="e.g. 2024-2025" />
          </div>
          <span asp-validation-for="AcademicYear" class="field-error" style="display:block;"></span>
        </div>
      </div>

      <!-- Enrollment Date -->
      <div class="col-12 col-md-6">
        <div class="form-group-fancy">
          <label asp-for="EnrollmentDate" class="form-label-fancy">Enrollment Date</label>
          <div class="input-wrap">
            <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">event</span></span>
            <input asp-for="EnrollmentDate" type="date" class="form-control fancy-input has-prefix" />
          </div>
          <p class="field-hint mt-2">When the student started their program</p>
        </div>
      </div>

    </div>
  </div>

  <!-- ── Action Bar ── -->
  <div class="d-flex align-items-center justify-content-between gap-3 anim-fade-up-2">
    <a asp-action="Students" class="btn-step-back text-decoration-none">
      <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">close</span>
      Cancel
    </a>
    <button type="submit" class="btn-submit" id="create-student-btn">
      <span class="material-symbols-outlined" style="font-size:18px;font-variation-settings:'FILL' 1,'wght' 400">person_add</span>
      Create Student
    </button>
  </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
      // Show server-error block if it has content
      document.addEventListener('DOMContentLoaded', function () {
          const block = document.getElementById('server-error-block');
          if (block && block.textContent.trim().length > 0) {
              block.style.display = 'block';
          }
      });

      function togglePasswordVisibility() {
          const input = document.getElementById('Password');
          const icon  = document.getElementById('pass-toggle-icon');
          if (!input || !icon) return;
          const isMasked = input.type === 'password';
          input.type = isMasked ? 'text' : 'password';
          icon.textContent = isMasked ? 'visibility_off' : 'visibility';
      }
    </script>
}
