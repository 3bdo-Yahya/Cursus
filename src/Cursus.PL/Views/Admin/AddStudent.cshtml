@{
    ViewData["Title"] = "Add Student";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/courses.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/students.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/add-course.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/add-student.css" asp-append-version="true"/>
}

<!-- ─── End Navvar ───────────────────────────────────────── -->

  <!-- Breadcrumb + Header -->
    <div class="mb-4 anim-fade-up">
      <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-0" style="font-size:12px;">
          <li class="breadcrumb-item"><a href="/Admin/Students" style="color:var(--c-muted);text-decoration:none;">Students</a></li>
          <li class="breadcrumb-item active" style="color:var(--c-primary);font-weight:600;">Add New Student</li>
        </ol>
      </nav>
      <div class="d-flex align-items-center justify-content-between gap-3">
        <div>
          <h1 class="fw-900 mb-1" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Add New Student</h1>
          <p class="mb-0" style="font-size:13px;color:var(--c-muted);">Register a new student and assign their academic profile. Fields marked <span style="color:#dc2626;">*</span> are required.</p>
        </div>
        <a href="/Admin/Students" class="btn d-flex align-items-center gap-2 fw-600 flex-shrink-0 text-decoration-none"
           style="border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text);border-radius:12px;font-size:13px;padding:8px 16px;">
          <span class="material-symbols-outlined" style="font-size:17px;font-variation-settings:'FILL' 0,'wght' 300">arrow_back</span>
          Back
        </a>
      </div>
    </div>

    <form id="form-view" novalidate>
      <div id="student-success-alert" class="student-success-alert d-none anim-fade-up-1" role="status" aria-live="polite"></div>

      <!-- ── Account Credentials ── -->
      <div class="surface p-4 p-md-5 mb-3 anim-fade-up-1">
        <div class="step-panel-header mb-4">
          <div class="step-panel-icon">
            <span class="material-symbols-outlined" style="font-size:20px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">person</span>
          </div>
          <div>
            <h2 class="fw-800 mb-0" style="font-size:1.05rem;color:var(--c-text);">Account Credentials</h2>
            <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Login details for the student portal</p>
          </div>
        </div>

        <div class="row g-4">
          <!-- Full Name -->
          <div class="col-12 col-md-6">
            <div class="form-group-fancy" id="fg-fullname">
              <label class="form-label-fancy" for="student-fullname">Full Name <span style="color:#dc2626;">*</span></label>
              <div class="input-wrap">
                <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">badge</span></span>
                <input type="text" id="student-fullname" name="student-fullname" required class="form-control fancy-input has-prefix" placeholder="e.g. Ahmed Kamal" oninput="markFieldDirty(this)"/>
              </div>
              <p class="field-error" id="err-fullname">Full name is required</p>
            </div>
          </div>

          <!-- Email -->
          <div class="col-12 col-md-6">
            <div class="form-group-fancy" id="fg-email">
              <label class="form-label-fancy" for="student-email">Email Address <span style="color:#dc2626;">*</span></label>
              <div class="input-wrap">
                <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">mail</span></span>
                <input type="email" id="student-email" name="student-email" required class="form-control fancy-input has-prefix" placeholder="student@svu.edu.eg" oninput="markFieldDirty(this)"/>
              </div>
              <p class="field-error" id="err-email">A valid email address is required</p>
            </div>
          </div>

          <!-- Temporary Password -->
          <div class="col-12 col-md-6">
            <div class="form-group-fancy" id="fg-password">
              <label class="form-label-fancy" for="student-password">Temporary Password <span style="color:#dc2626;">*</span></label>
              <div class="input-wrap">
                <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">lock</span></span>
                <input type="password" id="student-password" name="student-password" required minlength="8" class="form-control fancy-input has-prefix" placeholder="Min. 8 characters" style="padding-right:44px;" oninput="markFieldDirty(this)"/>
                <button type="button" class="pass-toggle-btn" onclick="togglePassword()" title="Show/hide password">
                  <span class="material-symbols-outlined" id="pass-toggle-icon" style="font-size:18px;font-variation-settings:'FILL' 0,'wght' 300">visibility</span>
                </button>
              </div>
              <p class="field-hint">Student will be prompted to change this on first login</p>
              <p class="field-error" id="err-password">Password must be at least 8 characters</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Academic Information ── -->
      <div class="surface p-4 p-md-5 mb-4 anim-fade-up-2">
        <div class="step-panel-header mb-4">
          <div class="step-panel-icon">
            <span class="material-symbols-outlined" style="font-size:20px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">school</span>
          </div>
          <div>
            <h2 class="fw-800 mb-0" style="font-size:1.05rem;color:var(--c-text);">Academic Information</h2>
            <p class="mb-0" style="font-size:12px;color:var(--c-muted);">University placement and enrollment details</p>
          </div>
        </div>

        <div class="row g-4">

          <!-- University -->
          <div class="col-12 col-md-6">
            <div class="form-group-fancy" id="fg-university">
              <label class="form-label-fancy">University <span style="color:#dc2626;">*</span></label>
              <div class="custom-select-wrap" id="stud-uni-wrap" style="display:block;">
                <button type="button" class="custom-select-btn fancy-input" id="stud-uni-btn" style="height:40px;" onclick="toggleDropdown('stud-uni')">
                  <span class="custom-select-icon"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">account_balance</span></span>
                  <span class="custom-select-value" id="stud-uni-value" style="color:var(--c-muted);">Select university…</span>
                  <span class="material-symbols-outlined custom-select-arrow" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">expand_more</span>
                </button>
                <div class="custom-dropdown" id="stud-uni-dropdown">
                  <div class="custom-dropdown-item" data-value="svu" onclick="selectStudentUni(this)">
                    <span class="custom-dropdown-check material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
                    <div><div class="custom-dropdown-label">South Valley University</div><div class="custom-dropdown-sub">CS, IS, AI, IT</div></div>
                  </div>
                  <div class="custom-dropdown-item" data-value="auc" onclick="selectStudentUni(this)">
                    <span class="custom-dropdown-check material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
                    <div><div class="custom-dropdown-label">American University in Cairo</div><div class="custom-dropdown-sub">CS</div></div>
                  </div>
                  <div class="custom-dropdown-item" data-value="su" onclick="selectStudentUni(this)">
                    <span class="custom-dropdown-check material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
                    <div><div class="custom-dropdown-label">Sinai University</div><div class="custom-dropdown-sub">IT, CSSE, IDSS</div></div>
                  </div>
                </div>
                <select id="student-university" name="student-university" required class="d-none" aria-hidden="true" tabindex="-1">
                  <option value="">Select university</option>
                  <option value="svu">South Valley University</option>
                  <option value="auc">American University in Cairo</option>
                  <option value="su">Sinai University</option>
                </select>
              </div>
              <p class="field-error" id="err-university">Please select a university</p>
            </div>
          </div>

          <!-- Department -->
          <div class="col-12 col-md-6">
            <div class="form-group-fancy" id="fg-department">
              <label class="form-label-fancy">Department <span style="color:#dc2626;">*</span></label>
              <div class="custom-select-wrap" id="stud-dept-wrap" style="display:block;">
                <button type="button" class="custom-select-btn fancy-input" id="stud-dept-btn" style="height:40px;" onclick="toggleDropdown('stud-dept')" disabled>
                  <span class="custom-select-icon" id="stud-dept-icon-el"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">apartment</span></span>
                  <span class="custom-select-value" id="stud-dept-value" style="color:var(--c-muted);">Select university first…</span>
                  <span class="material-symbols-outlined custom-select-arrow" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">expand_more</span>
                </button>
                <div class="custom-dropdown" id="stud-dept-dropdown">
                  <!-- Populated by JS after university selection -->
                </div>
              </div>
              <p class="field-error" id="err-department">Please select a department</p>
            </div>
          </div>

          <!-- Academic Year -->
          <div class="col-12 col-md-4">
            <div class="form-group-fancy" id="fg-acyear">
              <label class="form-label-fancy" for="student-acyear">Academic Year <span style="color:#dc2626;">*</span></label>
              <div class="input-wrap">
                <span class="input-prefix"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">calendar_today</span></span>
                <input type="text" id="student-acyear" name="student-acyear" required pattern="\d{4}-\d{4}" class="form-control fancy-input has-prefix" placeholder="e.g. 2024-2025" oninput="markFieldDirty(this)"/>
              </div>
              <p class="field-error" id="err-acyear">Academic year must be in YYYY-YYYY format</p>
            </div>
          </div>

          <!-- Semester -->
          <div class="col-12 col-md-4">
            <div class="form-group-fancy" id="fg-semester">
              <label class="form-label-fancy">Current Semester <span style="color:#dc2626;">*</span></label>
              <div class="custom-select-wrap" style="display:block;">
                <button type="button" class="custom-select-btn fancy-input" id="stud-sem-btn" style="height:40px;" onclick="toggleDropdown('stud-sem')">
                  <span class="custom-select-icon"><span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">today</span></span>
                  <span class="custom-select-value" id="stud-sem-value">Spring</span>
                  <span class="material-symbols-outlined custom-select-arrow" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">expand_more</span>
                </button>
                <div class="custom-dropdown" id="stud-sem-dropdown">
                  <div class="custom-dropdown-item" data-value="fall" onclick="selectSemester(this)">
                    <span class="custom-dropdown-check material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
                    <span class="material-symbols-outlined" style="font-size:14px;color:#1d4ed8;font-variation-settings:'FILL' 0,'wght' 300">ac_unit</span>
                    <span class="custom-dropdown-label">Fall</span>
                  </div>
                  <div class="custom-dropdown-item selected" data-value="spring" onclick="selectSemester(this)">
                    <span class="custom-dropdown-check material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
                    <span class="material-symbols-outlined" style="font-size:14px;color:#d97706;font-variation-settings:'FILL' 0,'wght' 300">wb_sunny</span>
                    <span class="custom-dropdown-label">Spring</span>
                  </div>
                  <div class="custom-dropdown-item" data-value="summer" onclick="selectSemester(this)">
                    <span class="custom-dropdown-check material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
                    <span class="material-symbols-outlined" style="font-size:14px;color:#059669;font-variation-settings:'FILL' 0,'wght' 300">light_mode</span>
                    <span class="custom-dropdown-label">Summer</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Year Level -->
          <div class="col-12 col-md-4">
            <div class="form-group-fancy">
              <label class="form-label-fancy">Year Level</label>
              <div class="credits-selector d-flex gap-2 mt-1">
                <button type="button" class="credit-btn credit-btn-selected" data-val="1" onclick="selectYearLevel(this)">1</button>
                <button type="button" class="credit-btn" data-val="2" onclick="selectYearLevel(this)">2</button>
                <button type="button" class="credit-btn" data-val="3" onclick="selectYearLevel(this)">3</button>
                <button type="button" class="credit-btn" data-val="4" onclick="selectYearLevel(this)">4</button>
              </div>
              <input type="hidden" id="student-year-level" value="1"/>
              <p class="field-hint mt-2">Academic year in the program</p>
            </div>
          </div>

        </div>
      </div>

      <!-- ── Action Bar ── -->
      <div id="create-feedback" class="surface p-3 mb-3 d-none student-create-feedback" role="status" aria-live="polite"></div>

      <div class="d-flex align-items-center justify-content-between gap-3 anim-fade-up-2">
        <a href="/Admin/Students" class="btn-step-back text-decoration-none">
          <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">close</span>
          Cancel
        </a>
        <button type="button" class="btn-submit" id="create-student-btn">
          <span class="material-symbols-outlined" style="font-size:18px;font-variation-settings:'FILL' 1,'wght' 400">person_add</span>
          Create Student
        </button>
      </div>

    </form><!-- /form-view -->

    <!-- ── Success State ── -->
    <div id="success-state" class="d-none text-center anim-fade-up">
      <div class="surface p-5">
        <div class="success-ring mx-auto mb-4">
          <span class="material-symbols-outlined" style="font-size:36px;color:#059669;font-variation-settings:'FILL' 1,'wght' 400">check_circle</span>
        </div>
        <h2 class="fw-900 mb-2" style="font-size:1.4rem;color:var(--c-text);">Student Created!</h2>
        <p class="mb-4" style="font-size:14px;color:var(--c-muted);">
          <strong id="success-name" style="color:var(--c-primary);"></strong> has been added to the system.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
          <a href="/Admin/Students" class="btn btn-primary fw-700 d-flex align-items-center gap-2 text-decoration-none"
             style="border-radius:12px;font-size:13px;padding:10px 20px;box-shadow:0 4px 14px rgba(79,70,229,.28);">
            <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">group</span>
            View All Students
          </a>
          <button onclick="resetStudentForm()" class="btn fw-600 d-flex align-items-center gap-2"
                  style="border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text);border-radius:12px;font-size:13px;padding:10px 20px;">
            <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">person_add</span>
            Add Another
          </button>
        </div>
      </div>
    </div>
@section Scripts {
    <script src="~/js/pages/admin/courses.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin/students.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin/form-helpers.js" asp-append-version="true"></script>
    <script src="~/js/pages/admin/add-student.js" asp-append-version="true"></script>
}
