@{
    ViewData["Title"] = "Student Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/courses.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/admin/view-student.css" asp-append-version="true"/>
}

<!-- Actions -->
    <div class="mb-4 anim-fade-up">
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="font-size:12px;">
          <li class="breadcrumb-item"><a href="/Admin/Students" style="color:var(--c-muted);text-decoration:none;">Students</a></li>
          <li class="breadcrumb-item active" style="color:var(--c-primary);font-weight:600;">Ahmed Kamal</li>
        </ol>
      </nav>
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <h1 class="fw-900 mb-0" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Student Profile</h1>
        <div class="d-flex gap-2">
          <a href="/Admin/EditStudent" class="btn btn-primary d-flex align-items-center gap-2 fw-700 text-decoration-none"
             style="border-radius:12px;font-size:13px;padding:9px 16px;box-shadow:0 4px 14px rgba(79,70,229,.25);"
             onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform=''">
            <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 400">edit</span>
            Edit Student
          </a>
          <a href="/Admin/Students" class="btn d-flex align-items-center gap-2 fw-600 text-decoration-none"
             style="border:1px solid var(--c-border);background:var(--c-surface);color:var(--c-text);border-radius:12px;font-size:13px;padding:9px 16px;">
            <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">arrow_back</span>
            Back
          </a>
        </div>
      </div>
    </div>

    <!-- ── Hero Profile Card ── -->
    <div class="surface p-4 p-md-5 mb-4 anim-fade-up-1">
      <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-4">

        <!-- Avatar + Identity -->
        <div class="d-flex align-items-center gap-4">
          <div class="vs-avatar-lg" style="background:rgba(79,70,229,.12);color:var(--c-primary);">AK</div>
          <div>
            <h2 class="fw-900 mb-1" style="font-size:1.4rem;letter-spacing:-.3px;color:var(--c-text);">Ahmed Kamal</h2>
            <p class="mb-2" style="font-size:12.5px;color:var(--c-text-sub);">a.kamal@svu.edu.eg · ID&nbsp;20210001</p>
            <div class="d-flex flex-wrap gap-2">
              <span class="vs-chip">
                <span class="material-symbols-outlined" style="font-size:14px;font-variation-settings:'FILL' 0,'wght' 300">apartment</span>
                Computer Science
              </span>
              <span class="vs-chip">
                <span class="material-symbols-outlined" style="font-size:14px;font-variation-settings:'FILL' 0,'wght' 300">school</span>
                Year 3
              </span>
              <span class="vs-chip">
                <span class="material-symbols-outlined" style="font-size:14px;font-variation-settings:'FILL' 0,'wght' 300">calendar_month</span>
                Spring 2026
              </span>
              <span class="standing-badge standing-good"><span class="standing-dot"></span>Good Standing</span>
            </div>
          </div>
        </div>

        <!-- KPI strip -->
        <div class="vs-kpi-strip" data-scroll-group>
          <div class="vs-kpi surface">
            <div class="vs-kpi-icon" style="background:var(--icon-blue-bg);">
              <span class="material-symbols-outlined" style="font-size:16px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">auto_graph</span>
            </div>
            <p class="vs-kpi-label">CGPA</p>
            <p class="vs-kpi-value gpa-good">3.85</p>
          </div>
          <div class="vs-kpi surface">
            <div class="vs-kpi-icon" style="background:var(--icon-purple-bg);">
              <span class="material-symbols-outlined" style="font-size:16px;color:#7c3aed;font-variation-settings:'FILL' 0,'wght' 400">credit_score</span>
            </div>
            <p class="vs-kpi-label">Credits</p>
            <p class="vs-kpi-value" style="color:#7c3aed;">87 <span style="font-size:11px;font-weight:400;color:var(--c-muted);">/ 132</span></p>
          </div>
          <div class="vs-kpi surface">
            <div class="vs-kpi-icon" style="background:rgba(16,185,129,.08);">
              <span class="material-symbols-outlined" style="font-size:16px;color:#059669;font-variation-settings:'FILL' 0,'wght' 400">library_books</span>
            </div>
            <p class="vs-kpi-label">Completed</p>
            <p class="vs-kpi-value" style="color:#059669;">29 <span style="font-size:11px;font-weight:400;color:var(--c-muted);">courses</span></p>
          </div>
        </div>

      </div>

      <!-- Credit progress bar -->
      <div class="mt-4 pt-4" style="border-top:1px solid var(--c-border);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span style="font-size:12px;font-weight:600;color:var(--c-text-sub);">Graduation Progress</span>
          <span style="font-size:12px;color:var(--c-muted);">87 / 132 credits — <strong style="color:var(--c-text);">66%</strong></span>
        </div>
        <div class="vs-progress-track">
          <div class="vs-progress-bar" style="--prog-w:66%;"></div>
        </div>
        <p style="font-size:11px;color:var(--c-muted);margin-top:6px;">Projected graduation: <strong style="color:var(--c-text);">Spring 2028</strong> · <span style="color:#059669;">Eligible for overload (GPA ≥ 3.0)</span></p>
      </div>
    </div>

    <!-- ── Academic Summary + Notes ── -->
    <div class="row g-4 mb-4">

      <!-- Academic Summary -->
      <div class="col-12 col-lg-6" data-scroll="fade-right">
        <div class="surface p-4 h-100">
          <div class="d-flex align-items-center gap-2 mb-4">
            <div class="vc-section-icon" style="background:var(--c-soft);">
              <span class="material-symbols-outlined" style="font-size:18px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 400">history_edu</span>
            </div>
            <h3 class="fw-800 mb-0" style="font-size:1rem;color:var(--c-text);">Academic Summary</h3>
          </div>
          <ul class="vs-detail-list mb-0">
            <li>
              <span class="material-symbols-outlined vs-detail-icon" style="color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">account_balance</span>
              <span class="vs-detail-key">University</span>
              <strong>South Valley University</strong>
            </li>
            <li>
              <span class="material-symbols-outlined vs-detail-icon" style="color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">apartment</span>
              <span class="vs-detail-key">Department</span>
              <strong>Computer Science</strong>
            </li>
            <li>
              <span class="material-symbols-outlined vs-detail-icon" style="color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">calendar_today</span>
              <span class="vs-detail-key">Academic Year</span>
              <strong>2025 – 2026</strong>
            </li>
            <li>
              <span class="material-symbols-outlined vs-detail-icon" style="color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">menu_book</span>
              <span class="vs-detail-key">Semester</span>
              <strong>Semester 6</strong>
            </li>
            <li style="border-bottom:none;">
              <span class="material-symbols-outlined vs-detail-icon" style="color:#059669;font-variation-settings:'FILL' 0,'wght' 300">verified</span>
              <span class="vs-detail-key">Advising</span>
              <strong style="color:#059669;">On Track</strong>
            </li>
          </ul>
        </div>
      </div>

      <!-- Notes -->
      <div class="col-12 col-lg-6" data-scroll="fade-left">
        <div class="surface p-4 h-100 d-flex flex-column">
          <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-2">
              <div class="vc-section-icon" style="background:rgba(245,158,11,.08);">
                <span class="material-symbols-outlined" style="font-size:18px;color:#d97706;font-variation-settings:'FILL' 0,'wght' 400">sticky_note_2</span>
              </div>
              <h3 class="fw-800 mb-0" style="font-size:1rem;color:var(--c-text);">Advisor Notes</h3>
            </div>
            <button class="btn fw-600" style="font-size:11px;padding:4px 12px;border-radius:8px;border:1px solid var(--c-border);background:var(--c-bg);color:var(--c-text);"
                    onmouseover="this.style.borderColor='rgba(79,70,229,.3)'" onmouseout="this.style.borderColor='var(--c-border)'">
              <span class="material-symbols-outlined" style="font-size:14px;vertical-align:-3px;font-variation-settings:'FILL' 0,'wght' 300">add</span>
              Add note
            </button>
          </div>
          <div class="d-flex flex-column gap-3 flex-fill">
            <div class="vs-note">
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="material-symbols-outlined" style="font-size:14px;color:var(--c-primary);font-variation-settings:'FILL' 1,'wght' 400">info</span>
                <p class="mb-0 fw-700" style="font-size:12.5px;color:var(--c-text);">Registration Reminder</p>
                <span style="font-size:10px;color:var(--c-muted);margin-left:auto;">Mar 28, 2026</span>
              </div>
              <p class="mb-0" style="font-size:12px;color:var(--c-text-sub);">Register CS391 before next term to avoid graduation delay.</p>
            </div>
            <div class="vs-note">
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="material-symbols-outlined" style="font-size:14px;color:#059669;font-variation-settings:'FILL' 1,'wght' 400">trending_up</span>
                <p class="mb-0 fw-700" style="font-size:12.5px;color:var(--c-text);">Performance Trend</p>
                <span style="font-size:10px;color:var(--c-muted);margin-left:auto;">Feb 10, 2026</span>
              </div>
              <p class="mb-0" style="font-size:12px;color:var(--c-text-sub);">CGPA improved by +0.18 over the last two semesters. Overload eligible.</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- ── Course Records ── -->
    <div class="surface" data-scroll="fade-up" style="overflow:hidden;">
      <div class="px-4 py-3 d-flex align-items-center justify-content-between" style="border-bottom:1px solid var(--c-border);">
        <div class="d-flex align-items-center gap-2">
          <span class="material-symbols-outlined" style="font-size:18px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 300">library_books</span>
          <h3 class="fw-800 mb-0" style="font-size:1rem;color:var(--c-text);">Course Records</h3>
        </div>
        <span style="font-size:12px;color:var(--c-muted);">Last updated: Mar 30, 2026</span>
      </div>
      <div class="table-responsive">
        <table class="table courses-table mb-0">
          <thead>
            <tr>
              <th>Course</th>
              <th class="text-center">Credits</th>
              <th class="text-center">Grade</th>
              <th class="text-center">Points</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>

            <tr class="course-row">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="course-code">CS311</span>
                  <span class="course-name">Algorithms Analysis and Design</span>
                </div>
              </td>
              <td class="text-center"><span class="credits-badge">3</span></td>
              <td class="text-center"><span class="vs-grade vs-grade-good">A-</span></td>
              <td class="text-center" style="font-size:12px;color:var(--c-muted);">3.7</td>
              <td><span class="status-badge status-active"><span class="status-dot-sm"></span>Completed</span></td>
            </tr>

            <tr class="course-row">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="course-code">CS321</span>
                  <span class="course-name">Operating Systems I</span>
                </div>
              </td>
              <td class="text-center"><span class="credits-badge">3</span></td>
              <td class="text-center"><span class="vs-grade vs-grade-good">B+</span></td>
              <td class="text-center" style="font-size:12px;color:var(--c-muted);">3.3</td>
              <td><span class="status-badge status-active"><span class="status-dot-sm"></span>Completed</span></td>
            </tr>

            <tr class="course-row">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="course-code">CS241</span>
                  <span class="course-name">Object Oriented Programming</span>
                </div>
              </td>
              <td class="text-center"><span class="credits-badge">3</span></td>
              <td class="text-center"><span class="vs-grade vs-grade-good">A</span></td>
              <td class="text-center" style="font-size:12px;color:var(--c-muted);">4.0</td>
              <td><span class="status-badge status-active"><span class="status-dot-sm"></span>Completed</span></td>
            </tr>

            <tr class="course-row">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="course-code">AI413</span>
                  <span class="course-name">Machine Learning</span>
                </div>
              </td>
              <td class="text-center"><span class="credits-badge">3</span></td>
              <td class="text-center" style="color:var(--c-muted);font-size:13px;">—</td>
              <td class="text-center" style="font-size:12px;color:var(--c-muted);">—</td>
              <td><span class="status-badge" style="background:rgba(59,130,246,.1);color:#2563eb;border:1px solid rgba(59,130,246,.22);">
                <span class="material-symbols-outlined" style="font-size:12px;font-variation-settings:'FILL' 1,'wght' 400">radio_button_checked</span>
                In Progress
              </span></td>
            </tr>

            <tr class="course-row">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="course-code">CS391</span>
                  <span class="course-name">Software Engineering</span>
                </div>
              </td>
              <td class="text-center"><span class="credits-badge">3</span></td>
              <td class="text-center" style="color:var(--c-muted);font-size:13px;">—</td>
              <td class="text-center" style="font-size:12px;color:var(--c-muted);">—</td>
              <td><span class="status-badge" style="background:rgba(59,130,246,.1);color:#2563eb;border:1px solid rgba(59,130,246,.22);">
                <span class="material-symbols-outlined" style="font-size:12px;font-variation-settings:'FILL' 1,'wght' 400">radio_button_checked</span>
                In Progress
              </span></td>
            </tr>

          </tbody>
        </table>
      </div>
      <div class="px-4 py-3 d-flex align-items-center justify-content-between" style="border-top:1px solid var(--c-border);background:var(--c-surface);">
        <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Showing recent records · <strong style="color:var(--c-text);">29 total completed</strong></p>
        <a href="/Admin/EditStudent" class="btn fw-600 d-flex align-items-center gap-2 text-decoration-none"
           style="font-size:12px;color:var(--c-primary);background:var(--c-soft);border:1px solid rgba(79,70,229,.2);border-radius:10px;padding:6px 14px;">
          <span class="material-symbols-outlined" style="font-size:15px;font-variation-settings:'FILL' 0,'wght' 300">edit</span>
          Manage Records
        </a>
      </div>
    </div>
@section Scripts {
    <script src="~/js/pages/admin/courses.js" asp-append-version="true"></script>
}
