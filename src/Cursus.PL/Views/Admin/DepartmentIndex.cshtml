@using Cursus.Domain.DTOs
@using Cursus.PL.Models
@model PaginatedList<DepartmentDto>

@{
    ViewData["Title"] = "Department Management";
    var list    = Model.Items.ToList();
    var total   = (int)(ViewData["TotalCount"] ?? 0);
    var active  = list.Count(d => d.IsActive);
    var inactive = list.Count(d => !d.IsActive);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/courses.css" asp-append-version="true"/>
}

<partial name="_AdminAlerts" />

<!-- Page Header -->
<div class="d-flex flex-column flex-sm-row align-items-sm-start justify-content-between gap-3 mb-4 anim-fade-up">
  <div>
    <h1 class="fw-900 mb-1" style="font-size:1.65rem;letter-spacing:-.4px;color:var(--c-text);">Departments</h1>
    <p class="mb-0" style="font-size:13px;color:var(--c-muted);">
      Create and manage academic departments across universities.
    </p>
  </div>
  <a asp-action="DepartmentCreate"
     class="btn btn-primary d-flex align-items-center gap-2 fw-700 flex-shrink-0 text-decoration-none"
     style="border-radius:12px;font-size:13px;padding:9px 18px;box-shadow:0 4px 14px rgba(79,70,229,.28);">
    <span class="material-symbols-outlined" style="font-size:17px;font-variation-settings:'FILL' 1,'wght' 400">add</span>
    Add Department
  </a>
</div>

<!-- Stat Pills -->
<div class="d-flex flex-wrap gap-2 mb-4 anim-fade-up-1">
  <div class="stat-pill d-flex align-items-center gap-2">
    <span class="stat-pill-dot" style="background:#4F46E5;"></span>
    <span class="fw-700" style="font-size:13px;color:var(--c-text);">@total</span>
    <span style="font-size:12px;color:var(--c-muted);">Total</span>
  </div>
  <div class="stat-pill d-flex align-items-center gap-2">
    <span class="stat-pill-dot" style="background:#10b981;"></span>
    <span class="fw-700" style="font-size:13px;color:var(--c-text);">@active</span>
    <span style="font-size:12px;color:var(--c-muted);">Active</span>
  </div>
  <div class="stat-pill d-flex align-items-center gap-2">
    <span class="stat-pill-dot" style="background:var(--c-muted);"></span>
    <span class="fw-700" style="font-size:13px;color:var(--c-text);">@inactive</span>
    <span style="font-size:12px;color:var(--c-muted);">Inactive</span>
  </div>
</div>

@if (list.Count > 0)
{
<div class="surface anim-fade-up-2 overflow-hidden">
  <div class="table-responsive">
    <table class="table courses-table mb-0">
      <thead>
        <tr>
          <th class="col-name">Department</th>
          <th>University</th>
          <th class="text-center">Credits Req.</th>
          <th class="text-center">Min GPA</th>
          <th class="col-status">Status</th>
          <th class="col-actions text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var item in list)
        {
            <tr class="course-row">
              <td class="col-name">
                <div class="d-flex align-items-center gap-2">
                  <span class="material-symbols-outlined" style="font-size:16px;color:var(--c-primary);font-variation-settings:'FILL' 0,'wght' 300">apartment</span>
                  <span class="course-name">@item.Name</span>
                </div>
              </td>
              <td style="font-size:12px;color:var(--c-text-sub);">@item.UniversityName</td>
              <td class="text-center">
                <span style="display:inline-flex;align-items:center;gap:3px;padding:3px 10px;border-radius:8px;background:var(--c-bg);border:1px solid var(--c-border);font-size:12px;font-weight:700;color:var(--c-text-sub);white-space:nowrap;">@item.TotalCreditsRequired <span style="font-weight:400;font-size:11px;">cr</span></span>
              </td>
              <td class="text-center" style="font-size:12px;color:var(--c-text-sub);">@item.MinGpaForGraduation.ToString("F2")</td>
              <td class="col-status">
                @if (item.IsActive)
                {
                    <span class="status-badge status-active"><span class="status-dot-sm"></span>Active</span>
                }
                else
                {
                    <span class="status-badge status-archived">Inactive</span>
                }
              </td>
              <td class="col-actions text-end">
                <div class="actions-cell justify-content-end">
                  <a asp-action="DepartmentEdit" asp-route-id="@item.Id"
                     class="action-btn action-edit" title="Edit department">
                    <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">edit</span>
                  </a>
                  @if (item.IsActive)
                  {
                      <form asp-action="DepartmentDeactivate" asp-route-id="@item.Id" method="post" class="d-inline"
                            onsubmit="return confirm('Deactivate department @item.Name?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="action-btn" title="Deactivate"
                                style="color:#f59e0b;border:none;background:transparent;cursor:pointer;padding:6px 8px;border-radius:8px;">
                          <span class="material-symbols-outlined" style="font-size:16px;font-variation-settings:'FILL' 0,'wght' 300">block</span>
                        </button>
                      </form>
                  }
                </div>
              </td>
            </tr>
        }
      </tbody>
    </table>
  </div>
  <partial name="_Pagination" />
</div>
}
else
{
<div class="surface anim-fade-up-2 overflow-hidden text-center py-5 px-3">
  <span class="material-symbols-outlined d-block mb-3" style="font-size:40px;color:var(--c-muted);font-variation-settings:'FILL' 0,'wght' 200">apartment</span>
  <p class="fw-700 mb-1" style="font-size:14px;color:var(--c-text);">No departments yet</p>
  <p class="mb-0" style="font-size:12px;color:var(--c-muted);">Create the first department to get started.</p>
</div>
}